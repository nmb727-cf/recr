                        <Form.Item name="experience_years" label="Experience" className="mb-2"><Input size="small" className="rounded-md" /></Form.Item>
                        <Form.Item name="current_salary" label="Current Salary" className="mb-2"><Input size="small" className="rounded-md" /></Form.Item>
                        <Form.Item name="expected_salary" label="Expected Salary" className="mb-2"><Input size="small" className="rounded-md" /></Form.Item>
                        <Form.Item name="notice_period" label="Notice Period" className="mb-2"><Input size="small" className="rounded-md" /></Form.Item>
                        <Form.Item name="availability" label="Availability" className="mb-2"><Input size="small" className="rounded-md" /></Form.Item>
                        <Form.Item name="location" label="Location" className="mb-2"><Input size="small" className="rounded-md" /></Form.Item>
                        <Form.Item name="work_mode" label="Work Mode" className="mb-2"><Select size="small" options={WORK_MODES} className="rounded-md" /></Form.Item>
                      </div>
                    </Panel>
                  </Collapse>

                  <div className="bg-white/50 p-4 rounded-xl border border-dashed border-slate-200 mb-6">
                    <Text className="text-[9px] font-bold uppercase text-slate-400 block mb-2">Set Follow-up Task</Text>
                    <Row gutter={8}>
                      <Col span={12}><Form.Item name="next_action" className="mb-0"><Input placeholder="Next Action..." size="small" className="rounded-md" /></Form.Item></Col>
                      <Col span={6}><Form.Item name="next_action_date" className="mb-0"><DatePicker size="small" className="w-full rounded-md" placeholder="Date" /></Form.Item></Col>
