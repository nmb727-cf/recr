// ── Detail Panel ─────────────────────────────────────────────────────────────

function DetailPanel({
  open, candidate, onClose, onTogglePin
}: {
  open: boolean
  candidate: RelationCandidate | null
  onClose: () => void
  onTogglePin: (c: RelationCandidate) => void
}) {
  const [activeTab, setActiveTab] = useState('activity')
  const [isSubmitModalOpen, setIsSubmitModalOpen] = useState(false)
  const [isCaptureOpen, setIsCaptureOpen] = useState(false)
  const [form] = Form.useForm()
  const [enrichForm] = Form.useForm()
  const queryClient = useQueryClient()

  const { data: interactionsData, isLoading: loadingInteractions } = useApiQuery(
    ['candidates-crm-interactions', candidate?.candidate_id],
    () => candidatesApi.crmInteractions(candidate!.candidate_id),
    { enabled: !!candidate && open }
  )

  const logMutation = useMutation({
    mutationFn: async (values: any) => {
      const { interaction_type, outcome, content, next_action, next_action_date, next_action_time, ...candidateData } = values
      
      // 1. Log Activity
      await candidatesApi.logCRMInteraction(candidate!.candidate_id, {
        interaction_type, outcome, content, next_action, next_action_date, next_action_time
      })

      // 2. Persist Captured Info
      const enrichmentFields = ['current_company', 'experience_years', 'current_salary', 'expected_salary', 'notice_period', 'availability', 'location', 'work_mode']
      const enrichment = enrichmentFields.reduce((acc: any, field) => {
        if (candidateData[field]) acc[field] = candidateData[field]
        return acc
      }, {})

      if (Object.keys(enrichment).length > 0) {
        await candidatesApi.update(candidate!.candidate_id, enrichment)
      }
    },
    onSuccess: () => {
      message.success('Activity logged and profile updated')
      queryClient.invalidateQueries({ queryKey: ['candidates-crm-interactions', candidate?.candidate_id] })
      queryClient.invalidateQueries({ queryKey: ['candidates-crm-pipeline'] })
      form.resetFields()
      setIsCaptureOpen(false)
    },
  })

  const updateMutation = useMutation({
    mutationFn: (values: any) => candidatesApi.update(candidate!.candidate_id, values),
    onSuccess: () => {
      message.success('Candidate details updated')
      queryClient.invalidateQueries({ queryKey: ['candidates-crm-pipeline'] })
    },
  })

  const shareMutation = useMutation({
    mutationFn: (channel: 'email' | 'whatsapp') => candidatesApi.createInviteLink({
      form_config: { title: 'Candidate Information Update' }
    }),
    onSuccess: (res: any, channel: 'email' | 'whatsapp') => {
      const url = `https://saas-demo.com/apply/${res.data.data.token}`
      if (channel === 'whatsapp') {
        window.open(`https://wa.me/?text=${encodeURIComponent('Please fill this form: ' + url)}`)
      } else {
        message.success(`Form link generated: ${url}`)
      }
    },
  })

  const TABS = [
    { key: 'activity',       label: 'Activity',       icon: <Zap size={13} /> },
    { key: 'enrich',         label: 'Enrich',         icon: <Tags size={13} /> },
    { key: 'mapping',        label: 'Job Mapping',    icon: <Target size={13} /> },
    { key: 'timeline',       label: 'History',        icon: <History size={13} /> },
  ]

  const completeness = useMemo(() => {
    if (!candidate) return 0
    const fields = ['email', 'phone', 'resume_url', 'expected_salary', 'notice_period', 'location']
    const filled = fields.filter(f => !!(candidate as any)[f]).length
    return Math.round((filled / fields.length) * 100)
  }, [candidate])

  const handleResumeUpload = (info: any) => {
    if (info.file.status === 'done') {
      message.success('Resume uploaded and parsed')
      queryClient.invalidateQueries({ queryKey: ['candidates-crm-pipeline'] })
    }
  }

  return (
    <Drawer
      open={open}
      onClose={onClose}
      width={640}
      styles={{
        header: { borderBottom: '1px solid #F1F5F9', padding: '20px 24px' },
        body:   { padding: 0, backgroundColor: '#fff' },
        footer: { borderTop: '1px solid #F1F5F9', padding: '16px 24px', backgroundColor: '#fff' }
      }}
      title={
        <div className="flex items-center justify-between w-full pr-8">
          <div className="flex items-center gap-3">
            <Avatar size={40} className="bg-slate-100 text-slate-700 font-bold">{candidate?.name.charAt(0)}</Avatar>
            <div className="flex flex-col">
              <div className="flex items-center gap-2">
                <h3 className="text-lg font-bold text-slate-900 m-0 leading-tight">{candidate?.name}</h3>
                <Button 
                  type="text" 
                  size="small" 
                  onClick={() => candidate && onTogglePin(candidate)}
                  icon={<Pin size={14} className={cn(candidate?.is_pinned ? "text-indigo-600 fill-indigo-600" : "text-slate-300")} />}
                />
              </div>
              <Space size={4} align="center">
                <Text className="text-xs text-slate-500 font-medium truncate max-w-[200px]">{candidate?.current_title} at {candidate?.current_company}</Text>
                <Divider type="vertical" className="border-slate-200" />
                <Tooltip title={`${completeness}% Complete`}>
                  <div className="flex items-center gap-1.5">
                    <div className="w-12 h-1 bg-slate-100 rounded-full overflow-hidden">
                      <div className="h-full bg-indigo-500 transition-all" style={{ width: `${completeness}%` }} />
                    </div>
                    <Text className="text-[10px] font-bold text-slate-400">{completeness}%</Text>
                  </div>
                </Tooltip>
              </Space>
            </div>
          </div>
          <div className="flex items-center gap-2">
            {!candidate?.resume_url && <Tag color="orange" className="m-0 border-none font-bold text-[9px] uppercase rounded-full">Missing Resume</Tag>}
            <Select 
              size="small" 
              placeholder="Rating"
              className="w-24 text-[10px] font-bold"
              value={candidate?.qualification_rating}
              onChange={(val) => updateMutation.mutate({ qualification_rating: val })}
              options={QUALIFICATION_OPTIONS.map(o => ({ 
                value: o.value, 
                label: <span className={cn("text-[10px] font-bold uppercase", `text-${o.color}-600`)}>{o.label}</span> 
              }))}
            />
          </div>
        </div>
      }
      footer={
        <div className="flex justify-between items-center w-full">
          <Button icon={<ExternalLink size={14} />} className="font-bold text-xs" onClick={() => window.open(`/candidates/${candidate?.candidate_id}/profile`, '_blank')}>Convert to Full Profile</Button>
          <Space size={12}>
            <Button className="font-bold text-xs" onClick={onClose}>Dismiss</Button>
            <Button type="primary" className="bg-slate-900 border-none font-bold text-xs" onClick={() => setIsSubmitModalOpen(true)}>Submit to Job</Button>
          </Space>
        </div>
      }
    >
      <div className="flex flex-col h-full">
        
        {/* Candidate Snapshot - Persistent Section */}
        <div className="p-6 bg-slate-50/50 border-b border-slate-100">
          <div className="flex items-center justify-between mb-4">
            <Text className="text-[10px] font-black uppercase tracking-widest text-slate-400">Candidate Snapshot</Text>
            <Button type="link" size="small" className="text-indigo-600 font-bold p-0 h-auto" onClick={() => setActiveTab('enrich')}>Edit Details</Button>
          </div>
          <div className="grid grid-cols-3 gap-y-4 gap-x-2">
            <SnapshotItem label="Experience" value={candidate?.experience_years ? `${candidate.experience_years} Years` : '—'} />
            <SnapshotItem label="Current Salary" value={candidate?.current_salary || '—'} />
            <SnapshotItem label="Expected Salary" value={candidate?.expected_salary || '—'} />
            <SnapshotItem label="Notice Period" value={candidate?.notice_period || '—'} />
            <SnapshotItem label="Location" value={candidate?.location || '—'} />
            <SnapshotItem label="Work Mode" value={candidate?.work_mode ? WORK_MODES.find(m => m.value === candidate.work_mode)?.label : '—'} />
            <SnapshotItem label="Interest Level" value={candidate?.interest_level || '—'} className="capitalize" />
            <SnapshotItem label="Skills" value={candidate?.skills?.join(', ') || '—'} span={2} />
          </div>
        </div>
        
        {/* Next Action Priority Section */}
        <div className="p-6 bg-white border-b border-slate-100">
          <Text className="text-[10px] font-bold uppercase tracking-widest text-slate-400 block mb-3">Next Action</Text>
          <div className="flex items-center justify-between">
            <div className="flex items-center gap-4">
              <div className="w-10 h-10 bg-indigo-50 text-indigo-600 rounded-xl flex items-center justify-center"><Zap size={20}/></div>
              <div className="flex flex-col">
                <Text strong className="text-sm text-slate-900 leading-none mb-1">{candidate?.next_action || 'No action set'}</Text>
                <div className="flex items-center gap-2">
                  <Text className="text-[11px] text-slate-500 font-medium">
                    {candidate?.next_action_date ? dayjs(candidate?.next_action_date).format('MMMM D, YYYY') : 'Not scheduled'}
                  </Text>
                  {candidate?.next_action_time && (
                    <Tag className="m-0 border-none bg-slate-100 text-slate-500 text-[9px] font-bold uppercase rounded-md">
                      {candidate.next_action_time}
                    </Tag>
                  )}
                </div>
              </div>
            </div>
            <Button size="small" type="text" className="text-indigo-600 font-bold hover:bg-indigo-50" onClick={() => setActiveTab('activity')}>Edit Action</Button>
          </div>
        </div>

        <div className="border-b border-slate-100 px-6 flex gap-6 shrink-0 bg-white sticky top-0 z-10">
          {TABS.map(tab => (
            <button
              key={tab.key}
              onClick={() => setActiveTab(tab.key)}
              className={cn(
                'flex items-center gap-2 py-4 text-xs font-bold transition-all relative border-b-2',
                activeTab === tab.key ? 'text-indigo-600 border-indigo-600' : 'text-slate-400 border-transparent hover:text-slate-600'
              )}
            >
              {tab.icon} {tab.label}
            </button>
          ))}
        </div>

        <div className="flex-1 overflow-y-auto custom-scrollbar">
          {activeTab === 'activity' && (
            <div className="p-6 space-y-6 animate-in fade-in duration-300">
              <div className="bg-slate-50 rounded-2xl p-5 border border-slate-200 shadow-sm">
                <Text className="text-[10px] font-black uppercase tracking-widest text-slate-400 block mb-4">Log Daily Activity</Text>
                <Form form={form} layout="vertical" onFinish={v => logMutation.mutate(v)}>
                  <Row gutter={12}>
                    <Col span={10}>
                      <Form.Item name="interaction_type" initialValue="call" rules={[{ required: true }]}>
                        <Select className="enterprise-select-lg" options={ACTIVITY_TYPES.map(t => ({ value: t.value, label: <Space>{t.icon} {t.label}</Space> }))} />
                      </Form.Item>
                    </Col>
                    <Col span={14}>
                      <Form.Item name="outcome">
                        <Select placeholder="Outcome" className="enterprise-select-lg" options={OUTCOME_OPTIONS} />
                      </Form.Item>
                    </Col>
                  </Row>
                  
                  <Form.Item name="content" className="mb-4">
                    <Input.TextArea placeholder="Summary / Discussion Notes..." rows={3} className="rounded-xl border-slate-200" />
                  </Form.Item>

                  <Collapse 
                    activeKey={isCaptureOpen ? ['1'] : []} 
                    onChange={() => setIsCaptureOpen(!isCaptureOpen)}
                    ghost 
                    className="mb-4"
                  >
                    <Panel header={<Text className="text-[10px] font-bold text-indigo-600 uppercase flex items-center gap-1 cursor-pointer"><Info size={12} /> Capture Candidate Details</Text>} key="1" showArrow={false}>
                      <div className="grid grid-cols-2 gap-x-4 gap-y-1">
