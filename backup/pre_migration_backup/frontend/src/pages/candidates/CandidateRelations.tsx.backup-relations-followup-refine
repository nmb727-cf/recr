// ── Helpers ───────────────────────────────────────────────────────────────────

function getCandidateIntelligence(cand: RelationCandidate) {
  const today = dayjs().startOf('day')
  const nextDate = cand.next_action_date ? dayjs(cand.next_action_date).startOf('day') : null
  const lastContactDays = cand.last_contacted_at ? dayjs().diff(dayjs(cand.last_contacted_at), 'day') : 99
  
  const isOverdue = nextDate && nextDate.isBefore(today)
  const isFollowToday = nextDate && nextDate.isSame(today)
  const isCold = lastContactDays > 5
  const isReady = ['qualified', 'ready_for_job'].includes(cand._stageKey) && (cand.match_score || 0) > 80

  return { isOverdue, isFollowToday, isCold, isReady }
}

// ── Main Component ────────────────────────────────────────────────────────────

export default function CandidateRelations() {
  const [viewMode, setViewMode] = useState<'list' | 'board'>('list')
  const [search, setSearch] = useState('')
  const [filterType, setFilterType] = useState<string | null>(null)
  const [isQuickAddOpen, setIsQuickAddOpen] = useState(false)
  const [selectedCandidate, setSelectedCandidate] = useState<RelationCandidate | null>(null)
  const [detailOpen, setDetailOpen] = useState(false)
  const [selectedRowKeys, setSelectedRowKeys] = useState<React.Key[]>([])

  const queryClient = useQueryClient()
  const { user } = useAuthStore()

  // ── Queries ──────────────────────────────────────────────────────────────
  const { data: pipelineData, isLoading } = useApiQuery(
    ['candidates-crm-pipeline'],
    candidatesApi.crmPipeline
  )
  const pipeline = (pipelineData as any)?.pipeline || {}

  // ── Mutations ─────────────────────────────────────────────────────────────
  const moveMutation = useMutation({
    mutationFn: ({ id, status, note, next_action_date, is_pinned, tags }: { id: string; status?: string; note?: string; next_action_date?: string; is_pinned?: boolean; tags?: string[] }) =>
      candidatesApi.moveCRMPipeline(id, { status, note, next_action_date, is_pinned, tags }),
    onSuccess: () => {
      message.success('Updated successfully')
      queryClient.invalidateQueries({ queryKey: ['candidates-crm-pipeline'] })
    },
    onError: (err: any) => message.error(err?.response?.data?.message || 'Failed to update'),
  })

  // ── Handlers ──────────────────────────────────────────────────────────────
  const handleOpenDetail = (cand: RelationCandidate) => {
    setSelectedCandidate(cand)
    setDetailOpen(true)
  }

  const handleStatusChange = (id: string, newStatus: string) => {
    moveMutation.mutate({ id, status: newStatus })
  }

  const handleSnooze = (id: string, days: number) => {
    moveMutation.mutate({ id, next_action_date: dayjs().add(days, 'day').format('YYYY-MM-DD') })
  }

  const handleTogglePin = (cand: RelationCandidate) => {
    moveMutation.mutate({ id: cand.pipeline_id, is_pinned: !cand.is_pinned })
  }

  const flatCandidates: RelationCandidate[] = useMemo(() => {
    if (!pipeline) return []
    return Object.entries(pipeline).flatMap(([stageKey, cands]) =>
      (cands as any[]).map(c => ({ 
        ...c, 
        _stageKey: stageKey,
        match_score: c.match_score || 0,
        matched_job_title: c.matched_job_title || 'N/A'
      }))
    ).sort((a, b) => {
      if (a.is_pinned && !b.is_pinned) return -1
      if (!a.is_pinned && b.is_pinned) return 1
      return 0
    })
  }, [pipeline])

  const intelligenceGroups = useMemo(() => {
    return flatCandidates.reduce((acc, c) => {
      const intel = getCandidateIntelligence(c)
      if (intel.isFollowToday) acc.followup.push(c)
      if (intel.isReady) acc.ready.push(c)
      if (intel.isOverdue) acc.overdue.push(c)
      if (intel.isCold) acc.cold.push(c)
      return acc
    }, { followup: [], ready: [], overdue: [], cold: [] } as Record<string, RelationCandidate[]>)
  }, [flatCandidates])

  const filteredCandidates = useMemo(() => {
    let result = flatCandidates.filter(c => {
      const matchesSearch = !search || 
        c.name.toLowerCase().includes(search.toLowerCase()) ||
        c.current_title?.toLowerCase().includes(search.toLowerCase())
      
      if (!matchesSearch) return false

      if (filterType === 'ready') return getCandidateIntelligence(c).isReady
      if (filterType === 'followup_today') return getCandidateIntelligence(c).isFollowToday
      if (filterType === 'cold') return getCandidateIntelligence(c).isCold
      if (filterType === 'overdue') return getCandidateIntelligence(c).isOverdue
      
      return true
    })

    // Apply sorting priority based on filter type
    if (filterType) {
      result = [...result].sort((a, b) => {
        const intelA = getCandidateIntelligence(a)
        const intelB = getCandidateIntelligence(b)
        
        if (filterType === 'overdue') {
          const dateA = dayjs(a.next_action_date || '9999-12-31')
          const dateB = dayjs(b.next_action_date || '9999-12-31')
          return dateA.diff(dateB)
        }
        
        if (filterType === 'ready') {
          return (b.match_score || 0) - (a.match_score || 0)
        }

        if (filterType === 'followup_today') {
          const timeA = a.next_action_time || '23:59'
          const timeB = b.next_action_time || '23:59'
          return timeA.localeCompare(timeB)
        }

        if (filterType === 'cold') {
          const dateA = dayjs(a.last_contacted_at || '1970-01-01')
          const dateB = dayjs(b.last_contacted_at || '1970-01-01')
          return dateA.diff(dateB)
        }

        return 0
      })
    }

    return result
  }, [flatCandidates, search, filterType])

  if (isLoading) return (
    <div className="flex flex-1 items-center justify-center bg-white h-[600px]">
      <Spin size="large" />
    </div>
  )

  return (
    <div className="flex flex-1 flex-col bg-white overflow-hidden">

      {/* PART 1: MINIMAL TOP BAR */}
      <div className="flex h-16 flex-none items-center justify-between border-b border-slate-200 px-6 bg-white z-20">
        <div className="flex items-center gap-3">
          <Button icon={<Plus size={16} />} onClick={() => setIsQuickAddOpen(true)} className="font-bold text-xs h-9 rounded-lg">Add Candidate</Button>
          <Button type="primary" icon={<Plus size={16} />} onClick={() => setIsQuickAddOpen(true)} className="font-bold text-xs h-9 rounded-lg bg-slate-900">Add Lead</Button>
        </div>

        <div className="flex items-center gap-4">
          <Input
            prefix={<Search size={14} className="text-slate-400" />}
            value={search}
            onChange={e => setSearch(e.target.value)}
            placeholder="Search relations..."
            className="h-9 w-64 rounded-lg bg-slate-50 border-slate-200 text-xs font-medium"
          />
          
          <Button icon={<ListIcon size={14} />} className="text-slate-500 font-bold text-xs h-9 px-4 rounded-lg">Filters</Button>

          <div className="flex items-center gap-1 bg-slate-100 p-1 rounded-lg border border-slate-200">
            <button
              onClick={() => setViewMode('list')}
              className={cn(
                'px-3 py-1 rounded-md text-[10px] font-bold uppercase tracking-wider transition-all',
                viewMode === 'list' ? 'bg-white text-slate-900 shadow-sm' : 'text-slate-500 hover:text-slate-700'
              )}
            >
              List
            </button>
            <button
              onClick={() => setViewMode('board')}
              className={cn(
                'px-3 py-1 rounded-md text-[10px] font-bold uppercase tracking-wider transition-all',
                viewMode === 'board' ? 'bg-white text-slate-900 shadow-sm' : 'text-slate-500 hover:text-slate-700'
              )}
            >
              Board
            </button>
          </div>
        </div>
      </div>

      {/* PART 2: COMPACT SMART COUNTERS */}
      <div className="flex h-12 flex-none items-center px-6 gap-8 bg-white border-b border-slate-100">
        <CompactCounter 
          label="Follow Today" 
          count={intelligenceGroups.followup.length} 
          active={filterType === 'followup_today'} 
          onClick={() => setFilterType(filterType === 'followup_today' ? null : 'followup_today')} 
          color="amber"
        />
        <CompactCounter 
          label="Ready" 
          count={intelligenceGroups.ready.length} 
          active={filterType === 'ready'} 
          onClick={() => setFilterType(filterType === 'ready' ? null : 'ready')} 
          color="emerald"
        />
        <CompactCounter 
          label="Overdue" 
          count={intelligenceGroups.overdue.length} 
          active={filterType === 'overdue'} 
          onClick={() => setFilterType(filterType === 'overdue' ? null : 'overdue')} 
          color="rose"
        />
        <CompactCounter 
          label="Cold" 
          count={intelligenceGroups.cold.length} 
          active={filterType === 'cold'} 
          onClick={() => setFilterType(filterType === 'cold' ? null : 'cold')} 
          color="blue"
        />
      </div>

      {/* PART 3 & 5: MAIN LIST & BULK ACTIONS */}
      <div className="flex-1 overflow-hidden relative flex flex-col">
        <div className="flex-1 overflow-hidden">
          {viewMode === 'list' ? (
            <div className="h-full overflow-auto custom-scrollbar">
              <ListView
                data={filteredCandidates}
                onOpen={handleOpenDetail}
                onStatusChange={handleStatusChange}
                onSnooze={handleSnooze}
                onTogglePin={handleTogglePin}
                selectedRowKeys={selectedRowKeys}
                setSelectedRowKeys={setSelectedRowKeys}
              />
            </div>
          ) : (
            <BoardView
              pipeline={pipeline}
              onOpen={handleOpenDetail}
              onMove={handleStatusChange}
            />
          )}
        </div>

        {/* Bulk Actions Bar - Fixed at bottom when active */}
        {selectedRowKeys.length > 0 && (
          <div className="h-16 flex-none bg-slate-900 text-white px-8 flex items-center justify-between border-t border-slate-800 z-50 animate-in slide-in-from-bottom-full duration-300">
            <div className="flex items-center gap-6">
              <div className="flex items-center gap-3 border-r border-white/20 pr-6">
                <div className="w-6 h-6 rounded-full bg-indigo-500 flex items-center justify-center text-[10px] font-black">
                  {selectedRowKeys.length}
                </div>
                <span className="text-xs font-bold uppercase tracking-widest">Selected</span>
              </div>
              
              <div className="flex items-center gap-8">
                <BulkAction icon={<User size={14} />} label="Assign Owner" />
                <BulkAction icon={<Activity size={14} />} label="Change Status" />
                <BulkAction icon={<Calendar size={14} />} label="Set Follow-up" />
                <BulkAction icon={<Archive size={14} />} label="Move to Database" />
                <BulkAction icon={<Target size={14} />} label="Submit" highlight />
              </div>
            </div>

            <button onClick={() => setSelectedRowKeys([])} className="text-white/40 hover:text-white transition-colors">
              <X size={20} />
            </button>
          </div>
        )}
      </div>

      {/* ── Overlays ──────────────────────────────────────────────────────── */}
      <DetailPanel
        open={detailOpen}
        candidate={selectedCandidate}
        onClose={() => setDetailOpen(false)}
        onTogglePin={handleTogglePin}
      />

      <QuickAddModal
        open={isQuickAddOpen}
        onClose={() => setIsQuickAddOpen(false)}
        onSuccess={() => queryClient.invalidateQueries({ queryKey: ['candidates-crm-pipeline'] })}
      />
    </div>
  )
}

function CompactCounter({ label, count, active, onClick, color }: { label: string, count: number, active: boolean, onClick: () => void, color: string }) {
  const dotColors: Record<string, string> = {
    amber: 'bg-amber-500',
    emerald: 'bg-emerald-500',
    rose: 'bg-rose-500',
    blue: 'bg-blue-500',
  }
  
  const activeBg: Record<string, string> = {
    amber: 'bg-amber-50 border-amber-200',
    emerald: 'bg-emerald-50 border-emerald-200',
    rose: 'bg-rose-50 border-rose-200',
    blue: 'bg-blue-50 border-blue-200',
  }

  return (
    <button 
      onClick={onClick}
      className={cn(
        "flex items-center gap-2.5 px-3 py-1.5 rounded-xl border border-transparent transition-all duration-200",
        active ? cn("shadow-sm", activeBg[color]) : "hover:bg-slate-50 opacity-60 hover:opacity-100"
      )}
    >
      <div className={cn("w-2 h-2 rounded-full", dotColors[color])} />
      <span className={cn(
        "text-[11px] font-bold",
        active ? "text-slate-900" : "text-slate-600"
      )}>{label}</span>
      <span className={cn(
        "text-[11px] font-black px-1.5 py-0.5 rounded-md min-w-[20px]",
        active ? "bg-white text-slate-900" : "bg-slate-50 text-slate-400"
      )}>{count}</span>
    </button>
  )
}

function BulkAction({ icon, label, highlight }: { icon: any, label: string, highlight?: boolean }) {
  return (
    <button className={cn(
      "flex items-center gap-2 text-[10px] font-bold uppercase tracking-widest transition-colors",
      highlight ? "text-indigo-400 hover:text-indigo-300" : "text-white/60 hover:text-white"
    )}>
      {icon} {label}
    </button>
  )
}

// ── List View ───────────────────────────────────────────────────────

function ListView({
  data, onOpen, onStatusChange, onSnooze, onTogglePin, selectedRowKeys, setSelectedRowKeys
}: {
  data: RelationCandidate[]
  onOpen: (c: RelationCandidate) => void
  onStatusChange: (id: string, status: string) => void
  onSnooze: (id: string, days: number) => void
  onTogglePin: (c: RelationCandidate) => void
  selectedRowKeys: React.Key[]
  setSelectedRowKeys: (keys: React.Key[]) => void
}) {
  const columns: ColumnsType<RelationCandidate> = [
    {
      title: '',
      key: 'pin',
      width: 40,
      render: (_, record) => (
        <Button 
          type="text" 
          size="small" 
          onClick={(e) => { e.stopPropagation(); onTogglePin(record) }}
          icon={<Pin size={14} className={cn(record.is_pinned ? "text-indigo-600 fill-indigo-600" : "text-slate-300")} />}
        />
      )
    },
    {
      title: 'Name',
      key: 'name',
      width: 260,
      render: (_, record) => {
        const intel = getCandidateIntelligence(record)
        const isIncomplete = !record.resume_url || !record.expected_salary || !record.email
        
        let attentionPill = null
        if (intel.isOverdue) attentionPill = <Tag color="error" className="m-0 border-none text-[8px] font-black uppercase px-1.5 py-0 leading-tight rounded-sm">Overdue</Tag>
        else if (intel.isFollowToday) attentionPill = <Tag color="warning" className="m-0 border-none text-[8px] font-black uppercase px-1.5 py-0 leading-tight rounded-sm">Today</Tag>
        else if (intel.isReady) attentionPill = <Tag color="success" className="m-0 border-none text-[8px] font-black uppercase px-1.5 py-0 leading-tight rounded-sm">Ready</Tag>
        else if (intel.isCold) attentionPill = <Tag className="m-0 border-none bg-slate-100 text-slate-400 text-[8px] font-black uppercase px-1.5 py-0 leading-tight rounded-sm">Cold</Tag>

        return (
          <div className="flex items-center gap-0 relative">
            {/* Left Accent Strip */}
            {(intel.isOverdue || intel.isFollowToday || intel.isReady) && (
              <div className={cn(
                "absolute -left-4 top-0 bottom-0 w-1 rounded-r-full",
                intel.isOverdue ? "bg-rose-500" : intel.isFollowToday ? "bg-amber-500" : "bg-emerald-500"
              )} />
            )}
            
            <Space onClick={() => onOpen(record)} className="cursor-pointer group pl-1">
              <Badge dot={isIncomplete} offset={[-2, 30]} color="orange" title="Profile Incomplete">
                <Avatar size={32} className="bg-slate-100 text-slate-700 font-bold text-xs">
                  {record.name.charAt(0)}
                </Avatar>
              </Badge>
              <div className="flex flex-col">
                <div className="flex items-center gap-2">
                  <Text strong className="text-xs text-slate-900 group-hover:text-indigo-600 transition-colors">
                    {record.name}
                  </Text>
                  {attentionPill}
                </div>
                <Text className="text-[10px] text-slate-400 font-medium">
                  {record.current_company || 'Lead'}
                </Text>
              </div>
            </Space>
          </div>
        )
      },
    },
    {
      title: 'Role',
      dataIndex: 'current_title',
      key: 'role',
      width: 180,
      render: (role) => <Text className="text-xs text-slate-600 font-medium">{role || '—'}</Text>
    },
    {
      title: 'Status',
      key: 'status',
      width: 160,
      render: (_, record) => (
        <Select
          className="enterprise-select-xs w-full"
          value={record._stageKey}
          onClick={e => e.stopPropagation()}
          onChange={newStatus => onStatusChange(record.pipeline_id, newStatus)}
          options={STATUSES.map(s => ({
            value: s.key,
            label: <span className="text-[10px] font-bold uppercase">{s.label}</span>,
          }))}
        />
      ),
    },
    {
      title: 'Rating',
      key: 'rating',
      width: 100,
      render: (_, record) => {
        const rating = QUALIFICATION_OPTIONS.find(o => o.value === record.qualification_rating)
        return rating ? (
          <Tag color={rating.color} className="m-0 border-none font-bold text-[9px] uppercase rounded-md">
            {rating.label}
          </Tag>
        ) : <Text className="text-[10px] text-slate-300 font-bold uppercase">—</Text>
      }
    },
    {
      title: 'Owner',
      key: 'owner',
      width: 140,
      render: (_, record) => (
        <Space size={8}>
          <Avatar size={20} className="bg-indigo-50 text-indigo-600 text-[10px] font-black">
            {record.assigned_to?.charAt(0) || 'U'}
          </Avatar>
          <Text className="text-xs text-slate-600 font-medium">{record.assigned_to_name || 'Unassigned'}</Text>
        </Space>
      )
    },
    {
      title: 'Last Interaction',
      key: 'last_interaction',
      width: 160,
      render: (_, record) => {
        const time = record.last_contacted_at ? dayjs(record.last_contacted_at).fromNow() : '—'
        const intel = getCandidateIntelligence(record)
        return (
          <Text className={cn("text-xs font-medium", intel.isCold ? "text-slate-400 italic" : "text-slate-500")}>
            {time}
          </Text>
        )
      }
    },
    {
      title: 'Next Action',
      key: 'next_action',
      width: 180,
      render: (_, record) => (
        <div className="flex flex-col">
          <Text className="text-xs text-slate-900 font-bold truncate block w-40">
            {record.next_action || '—'}
          </Text>
          {record.next_action_time && (
            <Text className="text-[9px] text-slate-400 font-bold uppercase">{record.next_action_time}</Text>
          )}
        </div>
      )
    },
    {
      title: 'Due',
      key: 'due',
      width: 100,
      render: (_, record) => {
        const intel = getCandidateIntelligence(record)
        return (
          <Text className={cn(
            "text-xs font-bold",
            intel.isOverdue ? "text-rose-500" : intel.isFollowToday ? "text-amber-500" : "text-slate-500"
          )}>
            {record.next_action_date ? dayjs(record.next_action_date).format('MMM DD') : '—'}
          </Text>
        )
      }
    },
    {
      title: 'Job Match',
      key: 'job_match',
      width: 140,
      render: (_, record) => (
        <div className="flex flex-col gap-1">
          <Text className="text-[10px] font-bold text-slate-700 truncate">{record.matched_job_title}</Text>
          <div className="flex items-center gap-2">
            <div className="flex-1 h-1 bg-slate-100 rounded-full overflow-hidden">
              <div className="h-full bg-indigo-500" style={{ width: `${record.match_score}%` }} />
            </div>
            <Text className="text-[10px] font-black text-indigo-600">{record.match_score}%</Text>
          </div>
        </div>
      )
    },
    {
      title: 'Source',
      dataIndex: 'source_channel',
      key: 'source',
      width: 120,
      render: (source) => <Tag className="m-0 border-none bg-slate-100 text-slate-500 text-[10px] font-bold uppercase rounded-md">{source || 'Organic'}</Tag>
    },
  ]

  const rowSelection: TableRowSelection<RelationCandidate> = {
    selectedRowKeys,
    onChange: setSelectedRowKeys,
  }

  return (
    <div className="bg-white h-full">
      <Table
        rowSelection={rowSelection}
        columns={columns}
        dataSource={data}
        rowKey="pipeline_id"
        pagination={{ pageSize: 50, hideOnSinglePage: true }}
        onRow={record => ({
          onClick: () => onOpen(record),
          className: 'cursor-pointer hover:bg-slate-50/50 transition-colors',
        })}
        scroll={{ x: 1400, y: 'calc(100vh - 240px)' }}
        className="enterprise-table"
      />
    </div>
  )
}

