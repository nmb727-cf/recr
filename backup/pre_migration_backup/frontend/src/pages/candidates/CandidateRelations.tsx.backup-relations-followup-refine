                  <div className="cursor-pointer">
                    <div className="w-12 h-12 bg-slate-100 rounded-2xl flex items-center justify-center text-slate-400 mx-auto mb-3 group-hover:text-indigo-600 group-hover:bg-indigo-50 transition-all">
                      <FileUp size={24} />
                    </div>
                    <Text strong className="text-sm text-slate-900 block">Upload New Resume</Text>
                    <Text className="text-[11px] text-slate-400 font-medium uppercase tracking-tight">PDF, DOCX · Auto-parsing enabled</Text>
                  </div>
                </Upload>
              </div>
            </div>
          )}

          {activeTab === 'enrich' && (
            <div className="p-6 space-y-6 animate-in fade-in duration-300">
              <div className="bg-slate-50 rounded-2xl p-6 border border-slate-200 shadow-sm">
                <Text className="text-[10px] font-black uppercase tracking-widest text-slate-400 block mb-6">Quick Profile Enrichment</Text>
                <Form 
                  form={enrichForm} 
                  layout="vertical" 
                  initialValues={candidate || {}} 
                  onFinish={v => updateMutation.mutate(v)}
                  className="enrich-form"
                >
                  <Row gutter={16}>
                    <Col span={12}><Form.Item name="email" label="Email"><Input className="rounded-lg" prefix={<Mail size={14} className="text-slate-400"/>} /></Form.Item></Col>
                    <Col span={12}><Form.Item name="phone" label="Phone"><Input className="rounded-lg" prefix={<Phone size={14} className="text-slate-400"/>} /></Form.Item></Col>
