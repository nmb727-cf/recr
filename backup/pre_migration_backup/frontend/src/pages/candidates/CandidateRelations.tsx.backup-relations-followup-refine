                       <div className="flex flex-col mb-4 p-4 rounded-xl border border-slate-100 bg-slate-50/30">
                         <div className="flex items-center justify-between mb-1">
                           <Text strong className="text-[10px] text-slate-900 uppercase tracking-wider">{i.interaction_type}</Text>
                           <Text className="text-[9px] text-slate-400 font-bold">Logged by You</Text>
                         </div>
                         <Text className="text-sm text-slate-600 mt-1 font-medium">{i.content}</Text>
                         {i.outcome && <Tag className="mt-2 w-fit m-0 border-none bg-indigo-50 text-indigo-600 text-[9px] font-bold uppercase rounded-md">{i.outcome}</Tag>}
                       </div>
                     ),
                     dot: <div className="p-1 bg-slate-100 rounded-full border border-slate-200" />
                   }))}
                 />
               )}
            </div>
          )}
        </div>
      </div>

      <SubmitToJobModal
        open={isSubmitModalOpen}
        candidate={candidate}
        onClose={() => setIsSubmitModalOpen(false)}
        onSuccess={() => {
          setIsSubmitModalOpen(false)
          onClose()
          queryClient.invalidateQueries({ queryKey: ['candidates-crm-pipeline'] })
        }}
      />
    </Drawer>
  )
}

