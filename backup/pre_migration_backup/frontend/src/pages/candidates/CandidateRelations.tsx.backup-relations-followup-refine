                <div>
                  <Text strong className="text-xs text-indigo-900 block">Enrich Profile via Candidate</Text>
                  <Text className="text-[10px] text-indigo-500 font-medium">Send a secure form for them to fill details & resume.</Text>
                </div>
                <Space>
                  <Tooltip title="Send via WhatsApp">
                    <Button 
                      shape="circle" 
                      icon={<MessageCircle size={16} />} 
                      className="text-emerald-600 border-emerald-100" 
                      onClick={() => shareMutation.mutate('whatsapp')} 
                    />
                  </Tooltip>
                  <Tooltip title="Send via Email">
                    <Button 
                      shape="circle" 
                      icon={<Mail size={16} />} 
                      className="text-indigo-600 border-indigo-100" 
                      onClick={() => shareMutation.mutate('email')} 
