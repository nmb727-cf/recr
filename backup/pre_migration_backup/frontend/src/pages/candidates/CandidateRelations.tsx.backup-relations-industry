// ── Submit to Job Modal ───────────────────────────────────────────────────────

function SubmitToJobModal({
  open, candidate, onClose, onSuccess,
}: {
  open: boolean
  candidate: RelationCandidate | null
  onClose: () => void
  onSuccess: () => void
}) {
  const [targetJobId, setTargetJobId] = useState<string | null>(null)

  const { data: jobsData } = useApiQuery(
    ['active-jobs-list-relations'],
    () => http.get('/jobs/requisitions/?status=open')
  )
  const jobs = (jobsData as any)?.data || []

  const submitMutation = useMutation({
    mutationFn: async () => {
      await candidatesApi.moveCRMPipeline(candidate!.pipeline_id, {
        status: 'submitted',
        note: `Submitted to job: ${targetJobId}`,
      })
      await http.post('/pipeline/pipeline/submit/', {
        candidate_id: candidate!.candidate_id,
        requisition_id: targetJobId,
        source: 'relations_nurture',
      })
    },
    onSuccess: () => {
      message.success('Candidate handed off to ATS pipeline')
      onSuccess()
    },
  })

  return (
    <Modal
      title={
        <div className="flex items-center gap-2">
          <Target size={17} className="text-indigo-600" />
          <span className="font-black uppercase tracking-tight">ATS Submission Handoff</span>
        </div>
      }
      open={open}
      onCancel={onClose}
      onOk={() => { if (!targetJobId) return message.error('Select a target job'); submitMutation.mutate() }}
      okText="Confirm Submission"
      confirmLoading={submitMutation.isPending}
      width={480}
      okButtonProps={{
        className: 'bg-slate-900 h-10 px-8 rounded-xl font-black uppercase text-[10px] tracking-widest border-none',
      }}
      cancelButtonProps={{ className: 'rounded-xl h-10 px-6 font-bold' }}
    >
      <div className="py-5 space-y-5">
        <div className="p-4 rounded-2xl bg-slate-900 text-white flex items-center gap-3">
          <Avatar size={36} className="font-black" style={{ backgroundColor: '#4F46E5' }}>
            {candidate?.name.charAt(0)}
          </Avatar>
          <div>
            <Text className="block text-white font-black uppercase tracking-tight leading-none text-sm">
              {candidate?.name}
            </Text>
            <Text className="text-indigo-300 text-[9px] font-bold uppercase tracking-widest mt-1 block">
              {candidate?.current_title}
            </Text>
          </div>
        </div>
        <div className="space-y-1.5">
          <Text className="text-[9.5px] font-black uppercase text-slate-400 tracking-widest pl-1">
            Target Job Requisition
          </Text>
          <Select
            className="w-full"
            style={{ height: 42 }}
            placeholder="Search active jobs…"
            showSearch
            onChange={setTargetJobId}
            options={jobs.map((j: any) => ({ value: j.id, label: `${j.title} (${j.job_ref_id})` }))}
          />
        </div>
        <Alert
          showIcon
          type="info"
          message="Handoff Rule"
          description="Submitting will move this candidate from Relations into the active ATS pipeline."
          className="rounded-2xl text-xs"
        />
      </div>
    </Modal>
  )
}

// ── Quick Note Modal ──────────────────────────────────────────────────────────

function QuickNoteModal({
  open, candidate, onClose, onSuccess,
}: {
  open: boolean
  candidate: RelationCandidate | null
  onClose: () => void
  onSuccess: () => void
}) {
  const [form] = Form.useForm()

  const logMutation = useMutation({
    mutationFn: (values: any) =>
      candidatesApi.logCRMInteraction(candidate!.candidate_id, { ...values, interaction_type: 'note' }),
    onSuccess: () => {
      message.success('Note saved')
      form.resetFields()
      onSuccess()
      onClose()
    },
  })

  return (
    <Modal
      title={
        <div className="flex items-center gap-2">
          <StickyNote size={16} className="text-indigo-600" />
          <span className="font-black uppercase tracking-tight text-sm">Quick Note</span>
          {candidate && (
            <span className="text-[10px] font-bold text-slate-400 uppercase ml-1">— {candidate.name}</span>
          )}
        </div>
      }
      open={open}
      onCancel={() => { form.resetFields(); onClose() }}
      onOk={() => form.submit()}
      okText="Save Note"
