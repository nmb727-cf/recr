    >
      <Form form={form} layout="vertical" className="pt-4" onFinish={v => logMutation.mutate(v)}>
        <Form.Item
          name="content"
          rules={[{ required: true, message: 'Note content required' }]}
          className="mb-3"
        >
          <Input.TextArea
            placeholder="Quick observation, update, or reminder…"
            rows={4}
            className="rounded-xl border-slate-100 text-sm"
            autoFocus
          />
        </Form.Item>
        <Form.Item name="next_followup_date" label="Schedule follow-up (optional)" className="mb-0">
          <DatePicker placeholder="Pick a date" className="w-full rounded-xl h-9" />
