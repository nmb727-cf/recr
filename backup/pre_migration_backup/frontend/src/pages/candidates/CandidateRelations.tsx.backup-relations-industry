  const columns: ColumnsType<RelationCandidate & { _stageKey: string }> = [
    {
      title: 'Candidate',
      dataIndex: 'name',
      render: (text, record) => {
        const stage = STAGES.find(s => s.key === record._stageKey)
        return (
          <Space onClick={() => onOpen(record)} className="cursor-pointer group">
            <Avatar
              size={32}
              className="font-black text-[10px] border-2 shrink-0"
              style={{
                backgroundColor: `${stage?.color}18`,
                borderColor: `${stage?.color}35`,
                color: stage?.color,
              }}
            >
              {text.charAt(0)}
            </Avatar>
            <div>
              <Text strong className="text-xs uppercase tracking-tight block group-hover:text-indigo-600 transition-colors">
                {text}
              </Text>
              <Text className="text-[9px] font-bold text-slate-400 uppercase tracking-widest">
                {record.current_title}
              </Text>
            </div>
          </Space>
        )
      },
    },
    {
      title: 'Stage',
      dataIndex: '_stageKey',
      render: (_, record) => {
        const stage = STAGES.find(s => s.key === record._stageKey)
        return (
          <Tag
            style={{ backgroundColor: stage?.bg, color: stage?.color, border: `1px solid ${stage?.color}25` }}
            className="rounded-lg font-black uppercase text-[9px] px-2.5"
          >
            {stage?.label}
          </Tag>
        )
      },
    },
    {
      title: 'Next Action',
      dataIndex: 'next_action',
      render: (text, record) => {
        const overdue = record.next_action_date && dayjs(record.next_action_date).isBefore(dayjs(), 'day')
        return (
          <div className="flex items-center gap-2">
            <div className={cn('p-1.5 rounded-lg', overdue ? 'bg-red-50 text-red-400' : 'bg-indigo-50 text-indigo-500')}>
              {overdue ? <AlertTriangle size={11} /> : <Zap size={11} />}
            </div>
            <div>
              <Text className="text-[10px] font-black uppercase text-slate-900 block">{text || '—'}</Text>
              {record.next_action_date && (
                <Text className={cn('text-[9px] font-bold uppercase', overdue ? 'text-red-400' : 'text-slate-400')}>
                  {overdue
                    ? `${dayjs().diff(record.next_action_date, 'day')}d overdue`
                    : dayjs(record.next_action_date).format('MMM DD')}
                </Text>
              )}
            </div>
          </div>
        )
      },
    },
    {
      title: 'Owner',
      dataIndex: 'assigned_to',
      render: v => v
        ? <span className="flex items-center gap-1.5 text-[10px] font-bold text-slate-600"><User size={11} />{v}</span>
        : <span className="text-[9px] text-slate-300 font-bold">Unassigned</span>,
    },
    {
      title: 'Last Contact',
      dataIndex: 'last_contacted_at',
      render: v => <Text className="text-[10px] font-bold text-slate-500">{v ? dayjs(v).fromNow() : '—'}</Text>,
    },
    {
      title: 'Aging',
      dataIndex: 'days_in_stage',
      align: 'center',
      render: v => <Text className="text-xs font-black text-slate-400">{v}D</Text>,
    },
    {
      title: 'Signals',
      dataIndex: 'sentiment',
      render: (_, record) => {
        const sigs = getCardSignals(record, record._stageKey)
        return (
          <div className="flex items-center gap-1">
            {sigs.map(sig => (
              <span
                key={sig}
                className="inline-flex items-center gap-0.5 px-1.5 py-0.5 rounded text-[8px] font-black uppercase"
                style={{ backgroundColor: SIGNAL_DEFS[sig].bg, color: SIGNAL_DEFS[sig].color }}
              >
                {SIGNAL_DEFS[sig].icon}
              </span>
            ))}
            {sigs.length === 0 && <span className="text-[9px] text-slate-300 font-bold">—</span>}
          </div>
        )
      },
    },
  ]

  return (
    <div className="rounded-2xl border border-slate-100 bg-white shadow-sm overflow-hidden">
      <Table
        columns={columns}
        dataSource={allCandidates}
        rowKey="pipeline_id"
        pagination={false}
        className="enterprise-table"
        onRow={record => ({ onClick: () => onOpen(record), className: 'cursor-pointer hover:bg-slate-50/60 transition-colors' })}
      />
    </div>
  )
}

// ── Quick Add Modal ───────────────────────────────────────────────────────────

function QuickAddModal({
  open, onClose, onSuccess,
}: {
  open: boolean
  onClose: () => void
  onSuccess: () => void
}) {
  const [form] = Form.useForm()
  const queryClient = useQueryClient()

  const createMutation = useMutation({
    mutationFn: async (values: any) => {
      const res = await candidatesApi.create(values)
      const candidateId = res.data.data.candidate.id
      return await candidatesApi.addToCRMPipeline({
        candidate_id: candidateId,
        intent: form.getFieldValue('intent'),
        status: 'new_lead',
      })
    },
    onSuccess: () => {
      message.success('New lead ingested successfully')
      onSuccess()
      onClose()
      form.resetFields()
    },
    onError: (err: any) => message.error(err?.response?.data?.message || 'Failed to ingest lead'),
  })

  return (
    <Modal
      title={
        <div className="flex items-center gap-2">
          <Sparkles size={17} className="text-indigo-600" />
          <span className="font-black uppercase tracking-tight">Rapid Lead Intake</span>
        </div>
      }
      open={open}
      onCancel={onClose}
      onOk={() => form.submit()}
      confirmLoading={createMutation.isPending}
      width={520}
      okText="Ingest & Nurture"
      okButtonProps={{
        className:
          'bg-slate-900 h-10 px-8 rounded-xl font-black uppercase text-[10px] tracking-[0.1em] border-none shadow-lg shadow-slate-200',
      }}
      cancelButtonProps={{ className: 'rounded-xl h-10 px-6 font-bold uppercase text-[10px] border-slate-200' }}
    >
      <Form form={form} layout="vertical" className="pt-5" onFinish={v => createMutation.mutate(v)}>
        <Row gutter={14}>
          <Col span={12}>
            <Form.Item name="first_name" label="First Name" rules={[{ required: true }]}>
              <Input
                placeholder="John"
                className="h-10 rounded-xl bg-slate-50 border-slate-100 focus:bg-white transition-all font-bold text-xs"
              />
            </Form.Item>
          </Col>
          <Col span={12}>
            <Form.Item name="last_name" label="Last Name" rules={[{ required: true }]}>
              <Input
                placeholder="Doe"
                className="h-10 rounded-xl bg-slate-50 border-slate-100 focus:bg-white transition-all font-bold text-xs"
              />
            </Form.Item>
          </Col>
        </Row>
        <Form.Item name="email" label="Primary Email" rules={[{ required: true, type: 'email' }]}>
          <Input
            placeholder="john@example.com"
            className="h-10 rounded-xl bg-slate-50 border-slate-100 focus:bg-white transition-all font-bold text-xs"
          />
        </Form.Item>
        <Form.Item name="current_title" label="Current Designation">
          <Input
            placeholder="Senior Software Engineer"
            className="h-10 rounded-xl bg-slate-50 border-slate-100 focus:bg-white transition-all font-bold text-xs"
          />
        </Form.Item>
        <Divider className="my-5 border-slate-100" />
        <div className="bg-indigo-50/40 p-5 rounded-2xl border border-indigo-100/60">
          <Form.Item
            name="intent"
            label={<span className="text-indigo-600 font-black uppercase text-[9.5px] tracking-widest">Entry Intent</span>}
            initialValue="just_lead"
            className="mb-0"
          >
            <Select className="enterprise-select-lg" options={INTENT_OPTIONS} />
          </Form.Item>
          <Text className="text-[9.5px] text-indigo-400 font-bold uppercase tracking-tight mt-3 block">
            Intent guides automatic nurture workflows and priority signals.
          </Text>
        </div>
      </Form>
    </Modal>
  )
}
