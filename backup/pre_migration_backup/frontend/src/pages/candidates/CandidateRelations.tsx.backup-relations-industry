// ── Types ─────────────────────────────────────────────────────────────────────

interface RelationCandidate {
  pipeline_id: string
  candidate_id: string
  name: string
  current_title: string
  current_company: string
  days_in_stage: number
  next_action: string
  next_action_date: string | null
  sentiment: 'positive' | 'neutral' | 'negative'
  assigned_to: string | null
  last_contacted_at: string | null
  intent: string
}

type QuickActionType = 'call' | 'whatsapp' | 'note' | 'schedule' | 'submit'
type SignalKey = 'overdue' | 'no_response' | 'hot' | 'ready' | 'job_match'

// ── Constants ─────────────────────────────────────────────────────────────────

const STAGES = [
  { key: 'new_lead',        label: 'New Lead',        color: '#4F46E5', bg: '#EEF2FF' },
  { key: 'nurturing',       label: 'Nurturing',       color: '#F59E0B', bg: '#FFFBEB' },
  { key: 'qualified',       label: 'Qualified',       color: '#10B981', bg: '#ECFDF5' },
  { key: 'ready_to_submit', label: 'Ready to Submit', color: '#8B5CF6', bg: '#F5F3FF' },
]

const INTENT_OPTIONS = [
  { value: 'specific_job',    label: 'For Specific Job' },
  { value: 'future_jobs',     label: 'For Future Jobs' },
  { value: 'looking_for_job', label: 'Candidate Looking for Job' },
  { value: 'just_lead',       label: 'Just Lead / Not Sure' },
]

const SIGNAL_DEFS: Record<SignalKey, { label: string; color: string; bg: string; icon: React.ReactNode }> = {
  overdue:    { label: 'Overdue',     color: '#EF4444', bg: '#FEF2F2', icon: <AlertTriangle size={9} /> },
  no_response:{ label: 'No Response', color: '#F59E0B', bg: '#FFFBEB', icon: <Bell size={9} /> },
  hot:        { label: 'Hot',         color: '#EF4444', bg: '#FFF1F1', icon: <Flame size={9} /> },
  ready:      { label: 'Ready',       color: '#10B981', bg: '#ECFDF5', icon: <CheckCircle2 size={9} /> },
  job_match:  { label: 'Job Match',   color: '#8B5CF6', bg: '#F5F3FF', icon: <Target size={9} /> },
}

// ── Helpers ───────────────────────────────────────────────────────────────────

function getCardSignals(cand: RelationCandidate, stageKey: string): SignalKey[] {
  const sigs: SignalKey[] = []
  const today = dayjs()
  if (cand.next_action_date && dayjs(cand.next_action_date).isBefore(today, 'day')) sigs.push('overdue')
  if (!cand.last_contacted_at || today.diff(dayjs(cand.last_contacted_at), 'day') > 14) sigs.push('no_response')
  if (cand.sentiment === 'positive') sigs.push('hot')
  if (stageKey === 'ready_to_submit') sigs.push('ready')
  if (cand.intent === 'specific_job') sigs.push('job_match')
  // Prioritise: overdue > no_response > ready > hot > job_match
  return sigs.slice(0, 2)
}

// ── Main Component ────────────────────────────────────────────────────────────

export default function CandidateRelations() {
  const [viewMode, setViewMode] = useState<'board' | 'list'>('board')
  const [search, setSearch] = useState('')
  const [isQuickAddOpen, setIsQuickAddOpen] = useState(false)
  const [selectedCandidate, setSelectedCandidate] = useState<RelationCandidate | null>(null)
  const [detailOpen, setDetailOpen] = useState(false)
  const [quickNoteCandidate, setQuickNoteCandidate] = useState<RelationCandidate | null>(null)
  const [quickNoteOpen, setQuickNoteOpen] = useState(false)
  const [quickSubmitCandidate, setQuickSubmitCandidate] = useState<RelationCandidate | null>(null)
  const [quickSubmitOpen, setQuickSubmitOpen] = useState(false)

  const queryClient = useQueryClient()

  const { data: pipelineData, isLoading } = useApiQuery(
    ['candidates-crm-pipeline'],
    candidatesApi.crmPipeline
  )
  const pipeline = (pipelineData as any)?.pipeline || {}

  const moveMutation = useMutation({
    mutationFn: ({ id, status, note }: { id: string; status: string; note: string }) =>
      candidatesApi.moveCRMPipeline(id, { status, note }),
    onSuccess: () => {
      message.success('Lead stage updated')
      queryClient.invalidateQueries({ queryKey: ['candidates-crm-pipeline'] })
    },
    onError: (err: any) => message.error(err?.response?.data?.message || 'Failed to move lead'),
  })

  const handleOpenDetail = (cand: RelationCandidate) => {
    setSelectedCandidate(cand)
    setDetailOpen(true)
  }

  const handleQuickAction = (cand: RelationCandidate, action: QuickActionType) => {
    if (action === 'call') {
      message.info(`Initiating call workflow for ${cand.name}…`)
    } else if (action === 'whatsapp') {
      message.info(`Opening WhatsApp for ${cand.name}…`)
    } else if (action === 'note') {
      setQuickNoteCandidate(cand)
      setQuickNoteOpen(true)
    } else if (action === 'schedule') {
      setSelectedCandidate(cand)
      setDetailOpen(true)
    } else if (action === 'submit') {
      setQuickSubmitCandidate(cand)
      setQuickSubmitOpen(true)
    }
  }

  const handleMove = (id: string, status: string) => {
    Modal.confirm({
      title: 'Stage Transition',
      icon: <TrendingUp size={18} className="text-indigo-500" />,
      content: (
        <div className="pt-4 space-y-4">
          <Paragraph className="text-slate-500 text-xs font-medium">
            Moving to{' '}
            <Tag color="blue" className="rounded-lg font-black uppercase text-[9px]">
              {status.replace(/_/g, ' ')}
            </Tag>
            — provide rationale:
          </Paragraph>
          <Input.TextArea
            id="move-note"
            placeholder="Recruiter assessment…"
            rows={3}
            className="rounded-2xl border-slate-200 focus:border-indigo-300 transition-all"
          />
        </div>
      ),
      onOk: () => {
        const note = (document.getElementById('move-note') as HTMLTextAreaElement)?.value
        if (!note) { message.error('Rationale is required'); return Promise.reject() }
        moveMutation.mutate({ id, status, note })
      },
      okText: 'Confirm Transition',
      okButtonProps: { className: 'bg-indigo-600 rounded-xl font-black uppercase text-[10px] h-10 px-6' },
      cancelButtonProps: { className: 'rounded-xl h-10 px-6 font-bold' },
    })
  }

  if (isLoading) return (
    <div className="flex flex-1 items-center justify-center bg-white h-[600px]">
      <Space direction="vertical" align="center" size={24}>
        <Spin size="large" />
        <Text className="text-slate-400 font-medium uppercase tracking-[0.2em] text-[10px]">
          Synchronizing Relations…
        </Text>
      </Space>
    </div>
  )

  const searchedPipeline: Record<string, RelationCandidate[]> = search.trim()
    ? Object.fromEntries(
        Object.entries(pipeline).map(([k, v]) => [
          k,
          (v as RelationCandidate[]).filter(c =>
            c.name.toLowerCase().includes(search.toLowerCase()) ||
            c.current_title?.toLowerCase().includes(search.toLowerCase())
          ),
        ])
      )
    : pipeline

  return (
    <div className="flex flex-1 flex-col bg-slate-50/30 overflow-hidden">

      {/* ── Top Navigation ──────────────────────────────────────────────── */}
      <div className="flex h-14 flex-none items-center justify-between border-b border-slate-100 px-8 bg-white z-10">
        <div className="flex items-center gap-5">
          <div className="flex flex-col">
            <h1 className="text-sm font-black tracking-tight text-slate-900 leading-none">
              CANDIDATE RELATIONS
            </h1>
            <Text className="text-[9px] font-black text-indigo-500 uppercase tracking-[0.18em] mt-1 flex items-center gap-1.5">
              <div className="w-1.5 h-1.5 rounded-full bg-indigo-500 animate-pulse" />
              Lead Nurture Terminal
            </Text>
          </div>

          <div className="h-7 w-px bg-slate-100" />

          <div className="flex items-center gap-1 bg-slate-50 p-0.5 rounded-xl border border-slate-100">
            {[
              { key: 'board', icon: <Layout size={12} />, label: 'Board' },
              { key: 'list',  icon: <ListIcon size={12} />, label: 'List'  },
            ].map(v => (
              <button
                key={v.key}
                onClick={() => setViewMode(v.key as any)}
                className={cn(
                  'flex items-center gap-1.5 px-3.5 py-1.5 rounded-[10px] text-[10px] font-black uppercase tracking-widest transition-all',
                  viewMode === v.key
                    ? 'bg-white text-indigo-600 shadow-sm border border-slate-100'
                    : 'text-slate-400 hover:text-slate-600'
                )}
              >
                {v.icon} {v.label}
              </button>
            ))}
          </div>
        </div>

        <div className="flex items-center gap-3">
          <div className="relative group">
            <Search size={13} className="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 group-focus-within:text-indigo-500 transition-colors" />
            <input
              value={search}
              onChange={e => setSearch(e.target.value)}
              placeholder="Filter leads…"
              className="h-9 w-56 rounded-xl border border-slate-100 bg-slate-50 pl-8 pr-3 text-xs font-bold outline-none focus:border-indigo-200 focus:bg-white focus:ring-4 focus:ring-indigo-50/50 transition-all"
            />
          </div>
          <Button
            type="primary"
            icon={<Plus size={14} />}
            onClick={() => setIsQuickAddOpen(true)}
            className="h-9 rounded-xl bg-slate-900 border-none px-5 text-[10px] font-black uppercase tracking-[0.08em] shadow-lg shadow-slate-200/80 hover:bg-indigo-600 transition-all active:scale-95"
          >
            New Lead
          </Button>
        </div>
      </div>

      {/* ── Smart Header Signals ─────────────────────────────────────────── */}
      <SmartHeader pipeline={searchedPipeline} />

      {/* ── Board / List ────────────────────────────────────────────────── */}
      <div className="flex-1 overflow-hidden">
        {viewMode === 'board' ? (
          <BoardView
            pipeline={searchedPipeline}
            onOpen={handleOpenDetail}
            onMove={handleMove}
            onQuickAction={handleQuickAction}
          />
        ) : (
          <div className="p-8 h-full overflow-auto custom-scrollbar">
            <ListView pipeline={searchedPipeline} onOpen={handleOpenDetail} />
          </div>
        )}
      </div>

      {/* ── Overlays ──────────────────────────────────────────────────────── */}
      <DetailPanel open={detailOpen} candidate={selectedCandidate} onClose={() => setDetailOpen(false)} />

      <QuickNoteModal
        open={quickNoteOpen}
        candidate={quickNoteCandidate}
        onClose={() => setQuickNoteOpen(false)}
        onSuccess={() => queryClient.invalidateQueries({ queryKey: ['candidates-crm-pipeline'] })}
      />

      <SubmitToJobModal
        open={quickSubmitOpen}
        candidate={quickSubmitCandidate}
        onClose={() => setQuickSubmitOpen(false)}
        onSuccess={() => {
          setQuickSubmitOpen(false)
          queryClient.invalidateQueries({ queryKey: ['candidates-crm-pipeline'] })
        }}
      />

      <QuickAddModal
        open={isQuickAddOpen}
        onClose={() => setIsQuickAddOpen(false)}
        onSuccess={() => queryClient.invalidateQueries({ queryKey: ['candidates-crm-pipeline'] })}
      />
    </div>
  )
}

// ── Smart Header ──────────────────────────────────────────────────────────────

function SmartHeader({ pipeline }: { pipeline: Record<string, RelationCandidate[]> }) {
  const all = Object.values(pipeline).flat()
  const today = dayjs().startOf('day')

  const newLeads       = (pipeline['new_lead'] || []).length
  const followupsToday = all.filter(c => c.next_action_date && dayjs(c.next_action_date).isSame(today, 'day')).length
  const readyToSubmit  = (pipeline['ready_to_submit'] || []).length
  const overdue        = all.filter(c => c.next_action_date && dayjs(c.next_action_date).isBefore(today, 'day')).length

  const stats = [
    { label: 'New Leads',       value: newLeads,       color: '#4F46E5', bg: '#EEF2FF', icon: <Users size={13} /> },
    { label: 'Follow-ups Today',value: followupsToday, color: '#F59E0B', bg: '#FFFBEB', icon: <Bell size={13} /> },
    { label: 'Ready to Submit', value: readyToSubmit,  color: '#8B5CF6', bg: '#F5F3FF', icon: <CheckCircle2 size={13} /> },
    { label: 'Overdue',         value: overdue,        color: '#EF4444', bg: '#FEF2F2', icon: <AlertTriangle size={13} /> },
  ]

  return (
    <div className="flex items-center gap-3 px-8 py-3 bg-white border-b border-slate-100 shrink-0">
      {stats.map(s => (
        <div
          key={s.label}
          className="flex items-center gap-2.5 px-4 py-2 rounded-2xl border transition-all hover:shadow-sm cursor-default"
          style={{ backgroundColor: s.bg, borderColor: `${s.color}25` }}
        >
          <div style={{ color: s.color }}>{s.icon}</div>
          <div>
            <div className="text-[17px] font-black leading-none" style={{ color: s.color }}>
              {s.value}
            </div>
            <div className="text-[8.5px] font-black uppercase tracking-widest mt-0.5" style={{ color: `${s.color}80` }}>
              {s.label}
            </div>
          </div>
        </div>
      ))}

      <div className="ml-auto flex items-center gap-2 px-3 py-2 rounded-2xl bg-slate-50 border border-slate-100">
        <div className="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse" />
        <span className="text-[9px] font-black uppercase tracking-widest text-slate-400">
          {all.length} leads in pipeline
        </span>
      </div>
    </div>
  )
}

// ── Board View ────────────────────────────────────────────────────────────────

function BoardView({
  pipeline, onMove, onOpen, onQuickAction,
}: {
  pipeline: Record<string, RelationCandidate[]>
  onMove: (id: string, status: string) => void
  onOpen: (c: RelationCandidate) => void
  onQuickAction: (c: RelationCandidate, action: QuickActionType) => void
}) {
  const today = dayjs().startOf('day')

  return (
    <div className="flex h-full gap-0 overflow-x-auto custom-scrollbar">
      {STAGES.map((stage, idx) => {
        const cards = pipeline[stage.key] || []
        const overdueCount = cards.filter(c =>
          c.next_action_date && dayjs(c.next_action_date).isBefore(today, 'day')
        ).length
        const followupTodayCount = cards.filter(c =>
          c.next_action_date && dayjs(c.next_action_date).isSame(today, 'day')
        ).length

        return (
          <div
            key={stage.key}
            className={cn(
              'flex w-[310px] shrink-0 flex-col',
              idx < STAGES.length - 1 && 'border-r border-slate-100'
            )}
            style={{ backgroundColor: `${stage.color}04` }}
          >
            {/* Column Header */}
            <div className="shrink-0 px-5 pt-5 pb-3 bg-white border-b border-slate-100">
              <div className="flex items-center justify-between mb-2">
                <div className="flex items-center gap-2">
                  <div className="h-2 w-2 rounded-full" style={{ backgroundColor: stage.color }} />
                  <span className="text-[11px] font-black uppercase tracking-[0.14em] text-slate-800">
                    {stage.label}
                  </span>
                  <span
                    className="px-2 py-0.5 rounded-lg text-[9px] font-black"
                    style={{ backgroundColor: stage.bg, color: stage.color }}
                  >
                    {cards.length}
                  </span>
                </div>
                <button
                  className="w-6 h-6 rounded-lg flex items-center justify-center text-slate-300 hover:text-slate-600 hover:bg-slate-50 transition-all"
                >
                  <Plus size={13} />
                </button>
              </div>

              {/* Column meta signals */}
              <div className="flex items-center gap-2 min-h-[18px]">
                {overdueCount > 0 && (
                  <span className="flex items-center gap-1 text-[8.5px] font-black uppercase text-red-400">
                    <AlertTriangle size={8} /> {overdueCount} overdue
                  </span>
                )}
                {followupTodayCount > 0 && (
                  <span className="flex items-center gap-1 text-[8.5px] font-black uppercase text-amber-500">
                    <Bell size={8} /> {followupTodayCount} today
                  </span>
                )}
                {overdueCount === 0 && followupTodayCount === 0 && cards.length > 0 && (
                  <span className="text-[8.5px] font-bold uppercase text-slate-300 tracking-wide">
                    All clear
                  </span>
                )}
              </div>
            </div>

            {/* Column Cards */}
            <div className="flex-1 overflow-y-auto custom-scrollbar p-4 space-y-3">
              {cards.map(cand => (
                <CandidateCard
                  key={cand.pipeline_id}
                  cand={cand}
                  stageKey={stage.key}
                  accentColor={stage.color}
                  onOpen={onOpen}
                  onMove={onMove}
                  onQuickAction={onQuickAction}
                />
              ))}

              {cards.length === 0 && (
                <div className="flex flex-col items-center justify-center py-16 select-none">
                  <div
                    className="w-10 h-10 rounded-2xl flex items-center justify-center mb-3 opacity-20"
                    style={{ backgroundColor: stage.bg }}
                  >
                    <Users size={18} style={{ color: stage.color }} />
                  </div>
                  <span
                    className="text-[9px] font-black uppercase tracking-[0.2em] opacity-20"
                    style={{ color: stage.color }}
                  >
                    Queue Empty
                  </span>
                </div>
              )}
            </div>
          </div>
        )
      })}
    </div>
  )
}

// ── Candidate Card ─────────────────────────────────────────────────────────────

function CandidateCard({
  cand, stageKey, accentColor, onOpen, onMove, onQuickAction,
}: {
  cand: RelationCandidate
  stageKey: string
  accentColor: string
  onOpen: (c: RelationCandidate) => void
  onMove: (id: string, status: string) => void
  onQuickAction: (c: RelationCandidate, action: QuickActionType) => void
}) {
  const signals = getCardSignals(cand, stageKey)
  const today = dayjs()
  const isOverdue = Boolean(
    cand.next_action_date && dayjs(cand.next_action_date).isBefore(today, 'day')
  )
  const overdueDays = isOverdue
    ? today.diff(dayjs(cand.next_action_date), 'day')
    : 0

  const quickActions: { icon: React.ReactNode; label: string; action: QuickActionType; hoverCls: string }[] = [
    { icon: <Phone size={12} />,        label: 'Call',        action: 'call',     hoverCls: 'hover:bg-emerald-50 hover:text-emerald-600 text-slate-400' },
    { icon: <MessageSquare size={12} />,label: 'WhatsApp',    action: 'whatsapp', hoverCls: 'hover:bg-green-50 hover:text-green-600 text-slate-400'   },
    { icon: <StickyNote size={12} />,   label: 'Add Note',    action: 'note',     hoverCls: 'hover:bg-indigo-50 hover:text-indigo-600 text-slate-400' },
    { icon: <Calendar size={12} />,     label: 'Follow-up',   action: 'schedule', hoverCls: 'hover:bg-amber-50 hover:text-amber-600 text-slate-400'   },
    { icon: <ArrowUpRight size={12} />, label: 'Submit to ATS',action: 'submit',  hoverCls: 'hover:bg-purple-50 hover:text-purple-600 text-slate-400' },
  ]

  return (
    <div
      onClick={() => onOpen(cand)}
      className="group relative flex flex-col gap-0 rounded-2xl border border-slate-100 bg-white shadow-sm hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200 cursor-pointer overflow-hidden"
    >
      {/* Accent bar */}
      <div className="absolute left-0 top-0 bottom-0 w-[3px]" style={{ backgroundColor: accentColor }} />

      {/* Card body */}
      <div className="pl-4 pr-4 pt-4 pb-3 flex flex-col gap-2.5">

        {/* Row 1: Avatar + Name + Menu */}
        <div className="flex items-start justify-between gap-2">
          <div className="flex items-center gap-2.5 min-w-0 flex-1">
            <Avatar
              size={34}
              className="shrink-0 font-black text-[11px] border-2 shadow-sm"
              style={{
                backgroundColor: `${accentColor}18`,
                borderColor: `${accentColor}35`,
                color: accentColor,
              }}
            >
              {cand.name.charAt(0)}
            </Avatar>
            <div className="min-w-0 flex-1">
              <h4 className="text-[12.5px] font-black text-slate-900 truncate leading-none mb-1 group-hover:text-indigo-600 transition-colors">
                {cand.name}
              </h4>
              <p className="text-[10px] font-medium text-slate-400 truncate leading-none">
                {[cand.current_title, cand.current_company].filter(Boolean).join(' · ') || 'Professional'}
              </p>
            </div>
          </div>

          <Dropdown
            menu={{
              items: [
                { key: 'details', label: 'View Full Profile', icon: <User size={12} />, onClick: () => onOpen(cand) },
                { type: 'divider' },
                ...STAGES.filter(s => s.key !== stageKey).map(s => ({
                  key: s.key,
                  label: `Move → ${s.label}`,
                  onClick: (info: any) => { info.domEvent.stopPropagation(); onMove(cand.pipeline_id, s.key) },
                })),
              ],
            }}
            trigger={['click']}
          >
            <button
              onClick={e => e.stopPropagation()}
              className="opacity-0 group-hover:opacity-100 shrink-0 w-7 h-7 flex items-center justify-center rounded-lg text-slate-300 hover:text-slate-600 hover:bg-slate-50 transition-all"
            >
              <MoreHorizontal size={14} />
            </button>
          </Dropdown>
        </div>

        {/* Row 2: Signal chips */}
        {signals.length > 0 && (
          <div className="flex items-center gap-1.5 flex-wrap -mt-0.5">
            {signals.map(sig => (
              <span
                key={sig}
                className="inline-flex items-center gap-1 px-2 py-0.5 rounded-lg text-[8.5px] font-black uppercase tracking-tight"
                style={{ backgroundColor: SIGNAL_DEFS[sig].bg, color: SIGNAL_DEFS[sig].color }}
              >
                {SIGNAL_DEFS[sig].icon}
                {SIGNAL_DEFS[sig].label}
              </span>
            ))}
          </div>
        )}

        {/* Row 3: Meta (owner + last contact + days in stage) */}
        <div className="flex items-center gap-3 text-[9px] font-bold text-slate-400 uppercase tracking-tight">
          {cand.assigned_to && (
            <span className="flex items-center gap-1.5 shrink-0">
              <div
                className="w-4 h-4 rounded-full flex items-center justify-center text-[7.5px] font-black text-white"
                style={{ backgroundColor: accentColor }}
              >
                {cand.assigned_to.charAt(0)}
              </div>
              {cand.assigned_to.split(' ')[0]}
            </span>
          )}
          {cand.last_contacted_at ? (
            <span className="flex items-center gap-1 shrink-0">
              <Clock size={9} />
              {dayjs(cand.last_contacted_at).fromNow(true)}
            </span>
          ) : (
            <span className="flex items-center gap-1 text-red-300 shrink-0">
              <Clock size={9} /> Never contacted
            </span>
          )}
          <span className="ml-auto text-slate-300 font-black">{cand.days_in_stage}D</span>
        </div>

        {/* Row 4: Next action */}
        {cand.next_action && (
          <div
            className={cn(
              'flex items-center gap-2.5 rounded-xl p-2.5 border transition-colors',
              isOverdue ? 'bg-red-50/60 border-red-100' : 'bg-slate-50/80 border-slate-100/70'
            )}
          >
            <div
              className={cn(
                'flex h-6 w-6 items-center justify-center rounded-lg shrink-0',
                isOverdue ? 'bg-red-100 text-red-500' : 'bg-white shadow-sm text-indigo-500'
              )}
            >
              {isOverdue ? <AlertTriangle size={11} /> : <Zap size={11} />}
            </div>
            <div className="min-w-0 flex-1">
              <p className="text-[10px] font-black text-slate-900 truncate leading-none mb-0.5">
                {cand.next_action}
              </p>
              <p className={cn(
                'text-[9px] font-bold leading-none uppercase',
                isOverdue ? 'text-red-400' : 'text-slate-400'
              )}>
                {cand.next_action_date
                  ? isOverdue
                    ? `${overdueDays}d overdue`
                    : dayjs(cand.next_action_date).format('MMM DD')
                  : 'No date set'}
              </p>
            </div>
          </div>
        )}
      </div>

      {/* Quick Actions (hover reveal) */}
      <div className="px-3 pb-3 opacity-0 group-hover:opacity-100 translate-y-1 group-hover:translate-y-0 transition-all duration-200">
        <div className="flex items-center gap-0.5 pt-2 border-t border-slate-50">
          {quickActions.map(qa => (
            <Tooltip key={qa.action} title={qa.label} placement="bottom" mouseEnterDelay={0.5}>
              <button
                onClick={e => { e.stopPropagation(); onQuickAction(cand, qa.action) }}
                className={cn(
                  'flex-1 flex items-center justify-center py-1.5 rounded-lg transition-all',
                  qa.hoverCls
                )}
              >
                {qa.icon}
              </button>
            </Tooltip>
          ))}
        </div>
      </div>
    </div>
  )
}

// ── Detail Panel ──────────────────────────────────────────────────────────────

function DetailPanel({
  open, candidate, onClose,
}: {
  open: boolean
  candidate: RelationCandidate | null
  onClose: () => void
}) {
  const [activeTab, setActiveTab] = useState('interactions')
  const [isSubmitModalOpen, setIsSubmitModalOpen] = useState(false)
  const [form] = Form.useForm()
  const queryClient = useQueryClient()

  const { data: interactionsData, isLoading: loadingInteractions } = useApiQuery(
    ['candidates-crm-interactions', candidate?.candidate_id],
    () => candidatesApi.crmInteractions(candidate!.candidate_id),
    { enabled: !!candidate && open }
  )

  const logMutation = useMutation({
    mutationFn: (values: any) => candidatesApi.logCRMInteraction(candidate!.candidate_id, values),
    onSuccess: () => {
      message.success('Activity logged')
      queryClient.invalidateQueries({ queryKey: ['candidates-crm-interactions', candidate?.candidate_id] })
      form.resetFields()
    },
  })

  const archiveMutation = useMutation({
    mutationFn: (reason: string) =>
      candidatesApi.moveCRMPipeline(candidate!.pipeline_id, { status: 'lost', note: reason }),
    onSuccess: () => {
      message.success('Lead archived')
      queryClient.invalidateQueries({ queryKey: ['candidates-crm-pipeline'] })
      onClose()
    },
  })

  const handleArchive = () => {
    Modal.confirm({
      title: 'Archive Lead',
      content: (
        <div className="pt-4 space-y-3">
          <Paragraph className="text-xs text-slate-500">Select a reason for archiving:</Paragraph>
          <Select
            id="archive-reason"
            className="w-full"
            defaultValue="not_interested"
            options={[
              { value: 'not_interested',  label: 'Not Interested' },
              { value: 'not_qualified',   label: 'Not Qualified' },
              { value: 'no_response',     label: 'No Response' },
              { value: 'comp_mismatch',   label: 'Compensation Mismatch' },
            ]}
          />
        </div>
      ),
      onOk: () => archiveMutation.mutate('not_interested'),
      okText: 'Confirm Archive',
      okButtonProps: { danger: true, className: 'rounded-xl font-bold' },
    })
  }

  // Stage context for signals
  const stageKey = (() => {
    for (const s of STAGES) {
      if (s.key === candidate?.pipeline_id) return s.key
    }
    return 'new_lead'
  })()
  const stage = STAGES.find(s => s.key === stageKey) || STAGES[0]
  const isOverdue = Boolean(
    candidate?.next_action_date && dayjs(candidate.next_action_date).isBefore(dayjs(), 'day')
  )

  const TABS = [
    { key: 'interactions', label: 'Interactions', icon: <MessageSquare size={13} /> },
    { key: 'qualification', label: 'Qualification', icon: <ShieldCheck size={13} /> },
    { key: 'mapping',      label: 'Job Mapping',   icon: <Target size={13} /> },
    { key: 'timeline',     label: 'Timeline',       icon: <Activity size={13} /> },
  ]

  return (
    <Drawer
      open={open}
      onClose={onClose}
      width={520}
      styles={{
        header: { borderBottom: '1px solid #F1F5F9', padding: '20px 28px' },
        body:   { padding: 0, backgroundColor: '#F8FAFC' },
      }}
      title={
        <div className="flex items-center gap-3">
          <Avatar
            size={38}
            className="font-black text-sm shrink-0"
            style={{ backgroundColor: stage.color, color: '#fff' }}
          >
            {candidate?.name.charAt(0)}
          </Avatar>
          <div>
            <h3 className="text-sm font-black text-slate-900 tracking-tight m-0 leading-none">
              {candidate?.name}
            </h3>
            <div className="flex items-center gap-2 mt-1">
              <span
                className="text-[8.5px] font-black uppercase tracking-widest px-2 py-0.5 rounded-lg"
                style={{ backgroundColor: stage.bg, color: stage.color }}
              >
                {stage.label}
              </span>
              {isOverdue && (
                <span className="text-[8.5px] font-black uppercase tracking-widest px-2 py-0.5 rounded-lg bg-red-50 text-red-400">
                  Overdue
                </span>
              )}
            </div>
          </div>
        </div>
      }
      extra={
        <Space size={10}>
          <Tooltip title="Archive Lead">
            <Button
              icon={<Trash2 size={14} />}
              onClick={handleArchive}
              className="rounded-xl border-slate-200 hover:border-red-200 hover:text-red-500 transition-all w-9 h-9 p-0"
