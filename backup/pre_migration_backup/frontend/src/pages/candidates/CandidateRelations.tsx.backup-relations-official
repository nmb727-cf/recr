import React, { useState, useMemo } from 'react'
import {
  Typography, Button, Input, Select, Space, Tag, Avatar,
  Spin, Badge, message, Tooltip, Dropdown, Modal, Form, DatePicker,
  Row, Col, Alert, Drawer, Timeline, Divider, Table, Card,
  Progress
} from 'antd'
import type { ColumnsType } from 'antd/es/table'
import {
  Search, Plus, MoreHorizontal,
  Mail, Phone, MessageSquare, Calendar, Target,
  User, Clock, Zap, Trash2, ShieldCheck,
  Briefcase, DollarSign, TrendingUp, Bot, ArrowUpRight,
  Activity, Sparkles, AlertTriangle, CheckCircle2,
  Users, Bell, Layout, List as ListIcon, Info, ExternalLink,
  MapPin, Check, Globe, Send, MessageCircle, StickyNote,
  Flame, History, Save, X, Search as SearchIcon, ArrowRight
} from 'lucide-react'
import { useMutation, useQueryClient } from '@tanstack/react-query'
import dayjs from 'dayjs'
import relativeTime from 'dayjs/plugin/relativeTime'
import { candidatesApi } from '@/api/candidates'
import { useApiQuery } from '@/hooks/useApiQuery'
import { cn } from '@/utils/cn'
import { useAuthStore } from '@/store/authStore'
import http from '@/utils/http'

dayjs.extend(relativeTime)
const { Title, Text, Paragraph } = Typography

// ── Types ─────────────────────────────────────────────────────────────────────

interface RelationCandidate {
  pipeline_id: string
  candidate_id: string
  name: string
  current_title: string
  current_company: string
  days_in_stage: number
  next_action: string
  next_action_date: string | null
  sentiment: 'positive' | 'neutral' | 'negative'
  assigned_to: string | null
  assigned_to_name?: string
  last_contacted_at: string | null
  last_interaction_type?: 'call' | 'email' | 'note' | 'meeting' | 'whatsapp'
  intent: string
  source_channel?: string
  interest_level?: 'high' | 'medium' | 'low'
  availability?: string
  notice_period?: string
  expected_salary?: string
  location?: string
  work_mode?: string
  _stageKey: string
}

// ── Constants ─────────────────────────────────────────────────────────────────

const STATUSES = [
  { key: 'new_lead',        label: 'New Lead',        color: '#4F46E5', bg: '#EEF2FF' },
  { key: 'contacted',       label: 'Contacted',       color: '#3B82F6', bg: '#EFF6FF' },
  { key: 'interested',      label: 'Interested',      color: '#10B981', bg: '#ECFDF5' },
  { key: 'follow_up',       label: 'Follow-up',       color: '#F59E0B', bg: '#FFFBEB' },
  { key: 'qualified',       label: 'Qualified',       color: '#059669', bg: '#F0FDF4' },
  { key: 'ready_for_job',   label: 'Ready for Job',   color: '#8B5CF6', bg: '#F5F3FF' },
  { key: 'submitted',       label: 'Submitted',       color: '#D946EF', bg: '#FDF4FF' },
  { key: 'future_talent',   label: 'Future Talent',   color: '#64748B', bg: '#F8FAFC' },
  { key: 'not_interested',  label: 'Not Interested',  color: '#94A3B8', bg: '#F1F5F9' },
  { key: 'archive',         label: 'Archive',         color: '#475569', bg: '#F1F5F9' },
]

const INTENT_OPTIONS = [
  { value: 'specific_job',    label: 'For Specific Job' },
  { value: 'future_jobs',     label: 'For Future Jobs' },
  { value: 'looking_for_job', label: 'Candidate Looking for Job' },
  { value: 'just_lead',       label: 'Just Lead / Not Sure' },
]

// ── Main Component ────────────────────────────────────────────────────────────

export default function CandidateRelations() {
  const [viewMode, setViewMode] = useState<'list' | 'board'>('list')
  const [search, setSearch] = useState('')
  const [filterType, setFilterType] = useState<string | null>(null)
  const [isQuickAddOpen, setIsQuickAddOpen] = useState(false)
  const [selectedCandidate, setSelectedCandidate] = useState<RelationCandidate | null>(null)
  const [detailOpen, setDetailOpen] = useState(false)

  const queryClient = useQueryClient()
  const { user } = useAuthStore()

  // ── Queries ──────────────────────────────────────────────────────────────
  const { data: pipelineData, isLoading } = useApiQuery(
    ['candidates-crm-pipeline'],
    candidatesApi.crmPipeline
  )
  const pipeline = (pipelineData as any)?.pipeline || {}

  // ── Mutations ─────────────────────────────────────────────────────────────
  const moveMutation = useMutation({
    mutationFn: ({ id, status, note }: { id: string; status: string; note: string }) =>
      candidatesApi.moveCRMPipeline(id, { status, note }),
    onSuccess: () => {
      message.success('Status updated')
      queryClient.invalidateQueries({ queryKey: ['candidates-crm-pipeline'] })
    },
    onError: (err: any) => message.error(err?.response?.data?.message || 'Failed to update status'),
  })

  // ── Handlers ──────────────────────────────────────────────────────────────
  const handleOpenDetail = (cand: RelationCandidate) => {
    setSelectedCandidate(cand)
    setDetailOpen(true)
  }

  const handleStatusChange = (id: string, newStatus: string) => {
    moveMutation.mutate({ id, status: newStatus, note: 'Status updated via command center' })
  }

  if (isLoading) return (
    <div className="flex flex-1 items-center justify-center bg-white h-[600px]">
      <Space direction="vertical" align="center" size={24}>
        <Spin size="large" />
        <Text className="text-slate-400 font-medium uppercase tracking-[0.2em] text-[10px]">
          Powering Command Center…
        </Text>
      </Space>
    </div>
  )

  const flatCandidates: RelationCandidate[] = Object.entries(pipeline).flatMap(([stageKey, cands]) =>
    (cands as any[]).map(c => ({ ...c, _stageKey: stageKey }))
  )

  const filteredCandidates = flatCandidates.filter(c => {
    const matchesSearch = !search || 
      c.name.toLowerCase().includes(search.toLowerCase()) ||
      c.current_title?.toLowerCase().includes(search.toLowerCase())
    
    if (!matchesSearch) return false

    if (filterType === 'my_leads') return c.assigned_to === user?.id
    if (filterType === 'new') return c._stageKey === 'new_lead'
    if (filterType === 'followup_today') return c.next_action_date === dayjs().format('YYYY-MM-DD')
    if (filterType === 'overdue') return c.next_action_date && dayjs(c.next_action_date).isBefore(dayjs(), 'day')
    if (filterType === 'ready') return ['qualified', 'ready_for_job'].includes(c._stageKey)
    if (filterType === 'idle') return !c.last_contacted_at || dayjs().diff(dayjs(c.last_contacted_at), 'day') > 5
    
    return true
  })

  return (
    <div className="flex flex-1 flex-col bg-white overflow-hidden">

      {/* ── Top Navigation ──────────────────────────────────────────────── */}
      <div className="flex h-16 flex-none items-center justify-between border-b border-slate-100 px-8 bg-white z-10 shadow-sm">
        <div className="flex items-center gap-6">
          <div className="flex flex-col">
            <h1 className="text-lg font-black tracking-tighter text-slate-900 leading-none">
              RELATIONS HUB
            </h1>
            <Text className="text-[9px] font-black text-indigo-500 uppercase tracking-[0.2em] mt-1 flex items-center gap-1.5">
              <div className="w-1.5 h-1.5 rounded-full bg-indigo-500 animate-pulse" />
              Recruiter Command Center
            </Text>
          </div>

          <div className="h-8 w-px bg-slate-100" />

          <div className="flex items-center gap-1 bg-slate-50 p-1 rounded-xl border border-slate-100">
            <button
              onClick={() => setViewMode('list')}
              className={cn(
                'flex items-center gap-1.5 px-4 py-1.5 rounded-lg text-[10px] font-black uppercase tracking-widest transition-all',
                viewMode === 'list'
                  ? 'bg-white text-indigo-600 shadow-sm border border-slate-100'
                  : 'text-slate-400 hover:text-slate-600'
              )}
            >
              <ListIcon size={12} /> List
            </button>
            <button
              onClick={() => setViewMode('board')}
              className={cn(
                'flex items-center gap-1.5 px-4 py-1.5 rounded-lg text-[10px] font-black uppercase tracking-widest transition-all',
                viewMode === 'board'
                  ? 'bg-white text-indigo-600 shadow-sm border border-slate-100'
                  : 'text-slate-400 hover:text-slate-600'
              )}
            >
              <Layout size={12} /> Board
            </button>
          </div>
        </div>

        <div className="flex items-center gap-4">
          <div className="relative group">
            <SearchIcon size={14} className="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 group-focus-within:text-indigo-500 transition-colors" />
            <input
              value={search}
              onChange={e => setSearch(e.target.value)}
              placeholder="Search by name, role..."
              className="h-10 w-64 rounded-xl border border-slate-100 bg-slate-50 pl-9 pr-4 text-xs font-bold outline-none focus:border-indigo-200 focus:bg-white focus:ring-4 focus:ring-indigo-50/50 transition-all"
            />
          </div>
          <Button
            type="primary"
            icon={<Plus size={16} />}
            onClick={() => setIsQuickAddOpen(true)}
            className="h-10 rounded-xl bg-slate-900 border-none px-6 text-[10px] font-black uppercase tracking-widest shadow-lg shadow-slate-200 hover:bg-indigo-600 transition-all active:scale-95"
          >
            Add Lead
          </Button>
        </div>
      </div>

      {/* ── Command Center KPIs ─────────────────────────────────────────── */}
      <div className="flex h-20 flex-none items-center gap-4 px-8 border-b border-slate-100 bg-slate-50/30 overflow-x-auto custom-scrollbar">
        <KPIButton 
          label="My Leads" 
          count={flatCandidates.filter(c => c.assigned_to === user?.id).length} 
          color="#6366f1" 
          active={filterType === 'my_leads'} 
          onClick={() => setFilterType(filterType === 'my_leads' ? null : 'my_leads')} 
        />
        <KPIButton 
          label="New Leads" 
          count={flatCandidates.filter(c => c._stageKey === 'new_lead').length} 
          color="#4F46E5" 
          active={filterType === 'new'} 
          onClick={() => setFilterType(filterType === 'new' ? null : 'new')} 
        />
        <KPIButton 
          label="Follow-ups Today" 
          count={flatCandidates.filter(c => c.next_action_date === dayjs().format('YYYY-MM-DD')).length} 
          color="#F59E0B" 
          active={filterType === 'followup_today'} 
          onClick={() => setFilterType(filterType === 'followup_today' ? null : 'followup_today')} 
        />
        <KPIButton 
          label="Overdue" 
          count={flatCandidates.filter(c => c.next_action_date && dayjs(c.next_action_date).isBefore(dayjs(), 'day')).length} 
          color="#EF4444" 
          active={filterType === 'overdue'} 
          onClick={() => setFilterType(filterType === 'overdue' ? null : 'overdue')} 
        />
        <KPIButton 
          label="Ready to Submit" 
          count={flatCandidates.filter(c => ['qualified', 'ready_for_job'].includes(c._stageKey)).length} 
          color="#10B981" 
          active={filterType === 'ready'} 
          onClick={() => setFilterType(filterType === 'ready' ? null : 'ready')} 
        />
        <KPIButton 
          label="No Activity (5d+)" 
          count={flatCandidates.filter(c => !c.last_contacted_at || dayjs().diff(dayjs(c.last_contacted_at), 'day') > 5).length} 
          color="#64748B" 
          active={filterType === 'idle'} 
          onClick={() => setFilterType(filterType === 'idle' ? null : 'idle')} 
        />
      </div>

      {/* ── Main View Area ──────────────────────────────────────────────── */}
      <div className="flex-1 overflow-hidden">
        {viewMode === 'list' ? (
          <div className="p-6 h-full overflow-auto custom-scrollbar bg-white">
            <ListView
              data={filteredCandidates}
              onOpen={handleOpenDetail}
              onStatusChange={handleStatusChange}
            />
          </div>
        ) : (
          <BoardView
            pipeline={pipeline}
            onOpen={handleOpenDetail}
            onMove={handleStatusChange}
          />
        )}
      </div>

      {/* ── Overlays ──────────────────────────────────────────────────────── */}
      <DetailPanel
        open={detailOpen}
        candidate={selectedCandidate}
        onClose={() => setDetailOpen(false)}
      />

      <QuickAddModal
        open={isQuickAddOpen}
        onClose={() => setIsQuickAddOpen(false)}
        onSuccess={() => queryClient.invalidateQueries({ queryKey: ['candidates-crm-pipeline'] })}
      />
    </div>
  )
}

function KPIButton({ label, count, color, active, onClick }: { label: string, count: number, color: string, active: boolean, onClick: () => void }) {
  return (
    <button 
      onClick={onClick}
      className={cn(
        "flex flex-col gap-1 px-5 py-2.5 rounded-2xl border transition-all min-w-[140px] text-left",
        active ? "bg-white shadow-md" : "bg-transparent border-transparent hover:bg-white/50"
      )}
      style={active ? { borderColor: `${color}40` } : {}}
    >
      <span className="text-[10px] font-black uppercase tracking-widest" style={{ color: active ? color : '#94A3B8' }}>{label}</span>
      <div className="flex items-center justify-between gap-4">
        <span className="text-xl font-black" style={{ color: active ? '#111827' : '#64748B' }}>{count}</span>
        <div className="w-1.5 h-1.5 rounded-full" style={{ backgroundColor: color }} />
      </div>
    </button>
  )
}

// ── List View ───────────────────────────────────────────────────────

function ListView({
  data, onOpen, onStatusChange,
}: {
  data: RelationCandidate[]
  onOpen: (c: RelationCandidate) => void
  onStatusChange: (id: string, status: string) => void
}) {
  const columns: ColumnsType<RelationCandidate> = [
    {
      title: 'Candidate Name',
      key: 'name',
      render: (_, record) => (
        <Space onClick={() => onOpen(record)} className="cursor-pointer group">
          <Avatar size={34} className="bg-slate-100 text-slate-900 font-black text-[11px] uppercase border border-slate-200">
            {record.name.charAt(0)}
          </Avatar>
          <div className="min-w-0">
            <Text strong className="text-[12.5px] uppercase tracking-tight block group-hover:text-indigo-600 transition-colors">
              {record.name}
            </Text>
            <Text className="text-[9px] font-bold text-slate-400 uppercase tracking-widest truncate block">
              {record.current_company || 'Lead'}
            </Text>
          </div>
        </Space>
      ),
    },
    {
      title: 'Status',
      key: 'status',
      render: (_, record) => (
        <Select
          className="enterprise-select-xs w-36"
          value={record._stageKey}
          onClick={e => e.stopPropagation()}
          onChange={newStatus => onStatusChange(record.pipeline_id, newStatus)}
          options={STATUSES.map(s => ({
            value: s.key,
            label: (
              <Space size={6}>
                <div className="w-1.5 h-1.5 rounded-full" style={{ backgroundColor: s.color }} />
                <span className="text-[10px] font-bold uppercase">{s.label}</span>
              </Space>
            ),
          }))}
        />
      ),
    },
    {
      title: 'Attention',
      key: 'attention',
      align: 'center',
      render: (_, record) => {
        const isOverdue = record.next_action_date && dayjs(record.next_action_date).isBefore(dayjs(), 'day')
        const isToday = record.next_action_date === dayjs().format('YYYY-MM-DD')
        const isReady = ['qualified', 'ready_for_job'].includes(record._stageKey)
        const isNew = record._stageKey === 'new_lead'
        
        const lastContactDays = record.last_contacted_at ? dayjs().diff(dayjs(record.last_contacted_at), 'day') : 99
        const isIdleWarning = lastContactDays >= 3 && lastContactDays < 7
        const isIdleHigh = lastContactDays >= 7 && lastContactDays < 14
        const isIdleCritical = lastContactDays >= 14

        if (isOverdue) return <Tooltip title="Overdue Action"><div className="w-2.5 h-2.5 rounded-full bg-rose-500 animate-pulse shadow-rose-200 shadow-lg mx-auto" /></Tooltip>
        if (isToday) return <Tooltip title="Follow-up Today"><div className="w-2.5 h-2.5 rounded-full bg-amber-500 shadow-amber-200 shadow-lg mx-auto" /></Tooltip>
        if (isReady) return <Tooltip title="Ready to Submit"><div className="w-2.5 h-2.5 rounded-full bg-emerald-500 shadow-emerald-200 shadow-lg mx-auto" /></Tooltip>
        if (isNew) return <Tooltip title="New Lead"><div className="w-2.5 h-2.5 rounded-full bg-indigo-500 shadow-indigo-200 shadow-lg mx-auto" /></Tooltip>
        
        if (isIdleCritical) return <Tooltip title="Critical Inactivity (14d+)"><div className="w-2.5 h-2.5 rounded-full bg-rose-900 mx-auto" /></Tooltip>
        if (isIdleHigh) return <Tooltip title="High Inactivity (7d+)"><div className="w-2.5 h-2.5 rounded-full bg-rose-400 mx-auto" /></Tooltip>
        if (isIdleWarning) return <Tooltip title="Inactivity Warning (3d+)"><div className="w-2.5 h-2.5 rounded-full bg-slate-300 mx-auto" /></Tooltip>
        
        return <div className="w-2.5 h-2.5 rounded-full bg-slate-100 mx-auto" />
      }
    },
    {
      title: 'Owner',
      dataIndex: 'assigned_to',
      render: v => v ? (
        <Tag className="rounded-lg m-0 text-[10px] font-black text-slate-500 border-slate-100 bg-slate-50 px-2 py-0.5">
          {v.split(' ')[0]}
        </Tag>
      ) : <Text className="text-[10px] text-slate-300 italic font-bold">Unassigned</Text>,
    },
    {
      title: 'Last Interaction',
      key: 'last_interaction',
      render: (_, record) => {
        const iconMap = {
          call: <Phone size={11} />,
          email: <Mail size={11} />,
          note: <StickyNote size={11} />,
          meeting: <Users size={11} />,
          whatsapp: <MessageCircle size={11} />
        }
        const interactionType = record.last_interaction_type || 'call'
        const time = record.last_contacted_at ? dayjs(record.last_contacted_at).fromNow() : '—'
        
        return (
          <Space className="text-slate-500">
            <span className="text-slate-300">{iconMap[interactionType] || <Activity size={11} />}</span>
            <Text className="text-[10.5px] font-bold uppercase tracking-tight">{time}</Text>
          </Space>
        )
      }
    },
    {
      title: 'Next Action',
      key: 'next',
      render: (_, record) => {
        const isOverdue = record.next_action_date && dayjs(record.next_action_date).isBefore(dayjs(), 'day')
        const isToday = record.next_action_date === dayjs().format('YYYY-MM-DD')
        
        return (
          <div className="flex flex-col gap-0.5 max-w-[140px]">
            <Text className={cn("text-[10.5px] font-black uppercase truncate", isOverdue ? "text-rose-600" : isToday ? "text-amber-600" : "text-indigo-600")}>
              {record.next_action || '—'}
            </Text>
            <Text className={cn("text-[9px] font-bold uppercase", isOverdue ? "text-rose-400" : isToday ? "text-amber-400" : "text-slate-400")}>
              {record.next_action_date ? dayjs(record.next_action_date).format('MMM DD') : 'No Date'}
            </Text>
          </div>
        )
      },
    },
    {
      title: 'Job Match',
      key: 'match',
      render: (_, record) => (
        <div className="flex flex-col">
          <Text className="text-[10px] font-black uppercase text-slate-700">Senior Platform Engineer</Text>
          <Text className="text-[9px] font-bold text-indigo-500 uppercase tracking-tighter">(2 matches)</Text>
        </div>
      )
    },
    {
      title: 'Quick Actions',
      key: 'quick',
      align: 'right',
      render: (_, record) => (
        <Space onClick={e => e.stopPropagation()}>
          <Tooltip title="Call"><Button size="small" type="text" className="text-slate-300 hover:text-emerald-500" icon={<Phone size={14}/>} /></Tooltip>
          <Tooltip title="Add Note"><Button size="small" type="text" className="text-slate-300 hover:text-indigo-500" icon={<StickyNote size={14}/>} /></Tooltip>
          <Tooltip title="Schedule"><Button size="small" type="text" className="text-slate-300 hover:text-amber-500" icon={<Calendar size={14}/>} /></Tooltip>
          <Tooltip title="Submit"><Button size="small" type="text" className="text-slate-300 hover:text-purple-500" icon={<Target size={14}/>} /></Tooltip>
          <Button size="small" type="text" className="text-slate-300 hover:text-slate-900" icon={<ArrowRight size={14}/>} onClick={() => onOpen(record)} />
        </Space>
      ),
    },
  ]

  return (
    <div className="rounded-3xl border border-slate-100 bg-white shadow-soft-sm overflow-hidden animate-in fade-in duration-700">
      <Table
        columns={columns}
        dataSource={data}
        rowKey="pipeline_id"
        pagination={{ pageSize: 20, hideOnSinglePage: true }}
        onRow={record => ({
          onClick: () => onOpen(record),
          className: 'cursor-pointer hover:bg-slate-50/50 transition-colors',
        })}
        expandable={{
          expandedRowRender: (record) => (
            <div className="p-6 bg-slate-50/50 rounded-2xl border border-slate-100 mx-4 mb-4 flex gap-12">
              <div className="w-1/3 space-y-4">
                <Text className="text-[10px] font-black uppercase text-slate-400 tracking-widest block">Live Timeline</Text>
                <Timeline 
                  size="small"
                  items={[
                    { children: <div className="flex flex-col"><Text strong className="text-[11px] uppercase">Call Logged</Text><Text className="text-[10px] text-slate-400">2 days ago by {record.assigned_to_name || 'System'}</Text></div>, color: 'green' },
                    { children: <div className="flex flex-col"><Text strong className="text-[11px] uppercase">Email Sent</Text><Text className="text-[10px] text-slate-400">4 days ago</Text></div>, color: 'blue' },
                    { children: <div className="flex flex-col"><Text strong className="text-[11px] uppercase text-slate-400">Lead Created</Text><Text className="text-[10px] text-slate-400">1 week ago</Text></div>, color: 'gray' },
                  ]} 
                />
              </div>
              <div className="w-1/3 space-y-4 border-x border-slate-100 px-8">
                <Text className="text-[10px] font-black uppercase text-slate-400 tracking-widest block">Qualification Mapping</Text>
                <div className="space-y-3">
                   <div className="flex justify-between items-center"><Text className="text-[11px] text-slate-500 uppercase font-bold">Fit Score</Text><Badge count="94%" style={{ backgroundColor: '#10b981', fontSize: 10, fontWeight: 900 }} /></div>
                   <div className="flex justify-between items-center"><Text className="text-[11px] text-slate-500 uppercase font-bold">Notice Period</Text><Text className="text-[11px] font-black uppercase text-slate-900">30 Days</Text></div>
                   <div className="flex justify-between items-center"><Text className="text-[11px] text-slate-500 uppercase font-bold">Work Mode</Text><Tag className="m-0 text-[9px] font-black uppercase border-none bg-slate-100">Hybrid</Tag></div>
                </div>
              </div>
              <div className="flex-1 space-y-4">
                <Text className="text-[10px] font-black uppercase text-slate-400 tracking-widest block">Quick Action Log</Text>
                <Input.TextArea placeholder="Enter interaction summary..." rows={3} className="rounded-xl text-xs border-slate-200" />
                <Button size="small" type="primary" className="rounded-lg font-black uppercase text-[10px] bg-slate-900 h-9 px-6">Save Activity</Button>
              </div>
            </div>
          ),
          expandRowByClick: false,
        }}
      />
    </div>
  )
}

// ── Board View ────────────────────────────────────────────────────

function BoardView({
  pipeline, onOpen, onMove,
}: {
  pipeline: Record<string, RelationCandidate[]>
  onOpen: (c: RelationCandidate) => void
  onMove: (id: string, status: string) => void
}) {
  return (
    <div className="flex h-full gap-0 overflow-x-auto custom-scrollbar bg-white">
      {STATUSES.slice(0, 6).map((stage, idx) => (
        <div key={stage.key} className={cn(
          'flex w-[300px] shrink-0 flex-col border-r border-slate-50',
          idx === 5 && 'border-r-0'
        )}>
          <div className="flex h-14 items-center justify-between px-6 bg-white shrink-0 border-b border-slate-100/50">
            <div className="flex items-center gap-2.5">
              <div className="h-2 w-2 rounded-full" style={{ backgroundColor: stage.color }} />
              <span className="text-[11px] font-black uppercase tracking-[0.15em] text-slate-900">{stage.label}</span>
              <Badge
                count={(pipeline[stage.key] || []).length}
                style={{ backgroundColor: stage.bg, color: stage.color, fontWeight: 900, fontSize: '10px', boxShadow: 'none' }}
              />
            </div>
          </div>

          <div className="flex-1 space-y-4 overflow-y-auto p-4 custom-scrollbar bg-slate-50/20">
            {(pipeline[stage.key] || []).map((cand) => (
              <CandidateCard key={cand.pipeline_id} cand={cand} accentColor={stage.color} onClick={() => onOpen(cand)} />
            ))}
          </div>
        </div>
      ))}
    </div>
  )
}

function CandidateCard({ cand, accentColor, onClick }: { cand: any, accentColor: string, onClick: () => void }) {
