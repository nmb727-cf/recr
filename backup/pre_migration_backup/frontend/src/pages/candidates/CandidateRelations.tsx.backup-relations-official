// ── Modals ────────────────────────────────────────────────────────────────────

function SubmitToJobModal({ open, candidate, onClose, onSuccess }: { open: boolean; candidate: RelationCandidate | null; onClose: () => void; onSuccess: () => void }) {
  const [targetJobId, setTargetJobId] = useState<string | null>(null)
  const { data: jobsData } = useApiQuery(['active-jobs-list-relations'], () => http.get('/jobs/requisitions/?status=open'))
  const jobs = (jobsData as any)?.data || []

  const submitMutation = useMutation({
    mutationFn: async () => {
      await candidatesApi.moveCRMPipeline(candidate!.pipeline_id, {
        status: 'submitted',
        note: `Submitted to job: ${targetJobId}`,
      })
      await http.post('/pipeline/pipeline/submit/', {
        candidate_id: candidate!.candidate_id,
        requisition_id: targetJobId,
        source: 'relations_nurture',
      })
    },
    onSuccess: () => {
      message.success('Handed off to ATS')
      onSuccess()
    },
  })

  return (
    <Modal
      title={<div className="flex items-center gap-2"><Target size={18} className="text-indigo-600" /><span className="font-black uppercase tracking-tight">ATS Mission Handoff</span></div>}
      open={open}
      onCancel={onClose}
      onOk={() => { if (!targetJobId) return message.error('Select job'); submitMutation.mutate() }}
      okText="Confirm Submission"
      confirmLoading={submitMutation.isPending}
      className="rounded-[2.5rem] overflow-hidden"
      width={480}
      okButtonProps={{ className: 'bg-slate-900 h-11 px-8 rounded-xl font-black uppercase text-[10px] border-none shadow-xl shadow-slate-200' }}
    >
      <div className="py-6 space-y-6">
        <div className="space-y-2">
          <Text className="text-[10px] font-black uppercase text-slate-400 tracking-widest pl-1">Target Job Requisition</Text>
          <Select
            className="w-full h-11 rounded-xl"
            placeholder="Search active jobs..."
            showSearch
            onChange={setTargetJobId}
            options={jobs.map((j: any) => ({ value: j.id, label: `${j.title} (${j.job_ref_id})` }))}
          />
        </div>
        <Alert showIcon type="info" message="Handoff Rule" description="This will initiate a live application cycle in the ATS pipeline for this candidate." className="rounded-2xl" />
      </div>
    </Modal>
  )
}

function QuickAddModal({ open, onClose, onSuccess }: { open: boolean; onClose: () => void; onSuccess: () => void }) {
  const [form] = Form.useForm()
  const createMutation = useMutation({
    mutationFn: async (values: any) => {
      const res = await candidatesApi.create(values)
      const candidateId = res.data.data.candidate.id
      return await candidatesApi.addToCRMPipeline({
        candidate_id: candidateId,
        intent: form.getFieldValue('intent'),
        status: 'new_lead',
      })
    },
    onSuccess: () => {
      message.success('Lead added')
      onSuccess()
      onClose()
      form.resetFields()
    },
  })

  return (
    <Modal
      title={<div className="flex items-center gap-2"><Sparkles size={18} className="text-indigo-600" /><span className="font-black uppercase tracking-tight text-sm">Rapid Lead Intake</span></div>}
      open={open}
      onCancel={onClose}
      onOk={() => form.submit()}
      confirmLoading={createMutation.isPending}
      width={480}
      okText="Add & Nurture"
      okButtonProps={{ className: 'bg-slate-900 h-11 px-8 rounded-xl font-black uppercase text-[10px] border-none shadow-xl shadow-slate-200' }}
    >
      <Form form={form} layout="vertical" className="pt-6" onFinish={(v) => createMutation.mutate(v)}>
        <Row gutter={16}>
          <Col span={12}><Form.Item name="first_name" label="First Name" rules={[{ required: true }]}><Input className="h-11 rounded-xl bg-slate-50 border-slate-100" /></Form.Item></Col>
          <Col span={12}><Form.Item name="last_name" label="Last Name" rules={[{ required: true }]}><Input className="h-11 rounded-xl bg-slate-50 border-slate-100" /></Form.Item></Col>
        </Row>
        <Form.Item name="email" label="Email" rules={[{ required: true, type: 'email' }]}><Input className="h-11 rounded-xl bg-slate-50 border-slate-100" /></Form.Item>
        <Form.Item name="current_title" label="Current Designation"><Input className="h-11 rounded-xl bg-slate-50 border-slate-100" /></Form.Item>
        <Form.Item name="intent" label="Entry Intent" initialValue="just_lead"><Select className="enterprise-select-lg" options={INTENT_OPTIONS} /></Form.Item>
      </Form>
    </Modal>
  )
}
