// ─── Constants ───────────────────────────────────────────────────────────────

const JOB_STATUS_TABS = [
  { label: 'All Jobs', value: 'all' },
  { label: 'Active', value: 'active' },
  { label: 'Draft', value: 'draft' },
  { label: 'Pending', value: 'pending_approval' },
  { label: 'Closed', value: 'closed' },
]

const PRIORITY_STYLE: Record<string, { color: string; bg: string; label: string }> = {
  urgent: { color: '#ef4444', bg: '#fef2f2', label: 'Urgent' },
  high:    { color: '#f97316', bg: '#fff7ed', label: 'High' },
  medium:  { color: '#6366f1', bg: '#eef2ff', label: 'Medium' },
  low:     { color: '#94a3b8', bg: '#f8fafc', label: 'Low' },
}

// ─── Helpers ───────────────────────────────────────────────────────────────────

function avatarColor(name: string) {
  const colors = ['#6366f1', '#8b5cf6', '#ec4899', '#f97316', '#22c55e', '#14b8a6', '#3b82f6']
  return colors[(name?.charCodeAt(0) || 0) % colors.length]
}

const formatSalary = (amount: number | string, currency: string = 'INR') => 
  new Intl.NumberFormat('en-IN', { 
    style: 'currency', 
    currency: currency,
    maximumFractionDigits: 0
  }).format(Number(amount))

// ─── Main Component: JobsWorkbench ───────────────────────────────────────────

export default function JobsList() {
  const { t } = useTranslation(['jobs', 'common'])
  const navigate = useNavigate()
  const [searchParams, setSearchParams] = useSearchParams()
  const queryClient = useQueryClient()
  const user = useAuthStore((s) => s.user)

  // ── Workspace State ──────────────────────────────────────────────────────
  const [activeSurface, setActiveSurface] = useState<'jobs' | 'pipeline'>(
    (searchParams.get('tab') as 'jobs' | 'pipeline') || 'jobs'
  )
  const [activeStatusFilter, setActiveStatusFilter] = useState<string>(searchParams.get('status') || 'active')
  const [search, setSearch] = useState('')
  const [selectedJobId, setSelectedJobId] = useState<string | null>(searchParams.get('id'))
  const [createDrawerOpen, setCreateDrawerOpen] = useState(false)
  const [editingJob, setEditingJob] = useState<JobRequisition | null>(null)
  
  // Layout State (Mirroring Candidate module pattern)
  const [leftPanelCollapsed, setLeftPanelCollapsed] = useState(() => {
    return localStorage.getItem('jobs_left_panel_collapsed') === 'true'
  })
  const [rightPanelCollapsed, setRightPanelCollapsed] = useState(() => {
    return localStorage.getItem('jobs_right_panel_collapsed') === 'true'
  })

  const [activeJobTab, setActiveJobTab] = useState('overview')

  // ── Queries ──────────────────────────────────────────────────────────────
  const { data: usersData } = useApiQuery(['organisation-users'], () => organisationApi.listUsers())
  const users = (usersData as any)?.users ?? []

  const { data, isLoading, refetch } = useApiQuery(
    ['jobs', activeStatusFilter, search],
    () => requisitionsApi.list({
      status: activeStatusFilter === 'all' ? undefined : activeStatusFilter,
      search: search || undefined,
    })
  )

  const requisitions = useMemo(() => {
    const list = ((data as any)?.requisitions as JobRequisition[] | undefined) ??
                 ((data as any)?.data?.requisitions as JobRequisition[] | undefined) ??
                 []
    return list
  }, [data])

  useEffect(() => {
    if (!selectedJobId && requisitions.length > 0 && !isLoading) {
      setSelectedJobId(requisitions[0].id)
    }
  }, [requisitions, selectedJobId, isLoading])

  const selectedJob = useMemo(() => 
    requisitions.find(j => j.id === selectedJobId) || null
  , [requisitions, selectedJobId])

  useEffect(() => {
    const params: any = {}
    if (selectedJobId) params.id = selectedJobId
    if (activeStatusFilter !== 'active') params.status = activeStatusFilter
    params.tab = activeSurface
    setSearchParams(params, { replace: true })
  }, [selectedJobId, activeStatusFilter, activeSurface, setSearchParams])

  useEffect(() => {
    localStorage.setItem('jobs_left_panel_collapsed', String(leftPanelCollapsed))
  }, [leftPanelCollapsed])

  useEffect(() => {
    localStorage.setItem('jobs_right_panel_collapsed', String(rightPanelCollapsed))
  }, [rightPanelCollapsed])

  const handleSelectJob = (id: string) => {
    setSelectedJobId(id)
    if (activeSurface === 'jobs') setActiveJobTab('overview')
  }

  return (
    <div className="flex flex-1 flex-col bg-[#F8FAFC] overflow-hidden -m-6 h-[calc(100vh-56px)]">
      
      {/* ══ Level 1: Unified Module Header ══════════════════════════════════ */}
      <div className="flex h-12 flex-none items-center justify-between border-b border-slate-200 bg-white px-6 z-20 shadow-sm">
        <div className="flex items-center gap-6">
          <div className="flex items-center gap-3">
            <div className="flex h-7 w-7 items-center justify-center rounded-lg bg-indigo-600 text-white shadow-soft-sm">
              <Briefcase size={16} />
            </div>
            <h1 className="text-[11px] font-black text-slate-900 tracking-tight leading-none uppercase tracking-[0.15em]">Hiring Workspace</h1>
          </div>

          <div className="h-4 w-[1px] bg-slate-200" />

          {/* Core Navigation Tabs */}
          <div className="flex items-center gap-1">
            {([
              { key: 'jobs', label: 'Jobs', icon: Layers },
              { key: 'pipeline', label: 'Pipeline', icon: MousePointerClick }
            ] as const).map(surface => (
              <button
                key={surface.key}
                onClick={() => setActiveSurface(surface.key)}
                className={cn(
                  "flex items-center gap-2 px-4 py-1.5 rounded-xl text-[9px] font-black uppercase tracking-widest transition-all h-8",
                  activeSurface === surface.key 
                    ? "bg-indigo-50 text-indigo-700 border border-indigo-100 shadow-soft-sm" 
                    : "text-slate-400 hover:text-slate-600 hover:bg-slate-50 border border-transparent"
                )}
              >
                <surface.icon size={12} />
                {surface.label}
              </button>
            ))}
          </div>
        </div>

        <div className="flex items-center gap-3">
          <button 
            onClick={() => {
              setEditingJob(null)
              setCreateDrawerOpen(true)
            }}
            className="flex items-center gap-2 rounded-xl bg-indigo-600 px-4 py-1.5 text-[9px] font-black uppercase tracking-widest text-white hover:bg-indigo-700 transition shadow-soft-lg active:scale-95"
          >
            <Plus size={12} /> Create Job
          </button>
          <button
            onClick={() => refetch()}
            className="flex h-8 w-8 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-500 hover:bg-slate-50 shadow-soft-sm transition-all"
          >
            <RefreshCw size={14} className={cn(isLoading && "animate-spin")} />
          </button>
        </div>
      </div>

      {/* ══ Level 2: Body (Mirroring Candidate module layout) ═════════════════ */}
      <div className="flex flex-1 overflow-hidden">
        
        {/* COLUMN 1: Unified Job Rail (Left) */}
        <div 
          className={cn(
            "flex flex-none flex-col overflow-hidden border-r border-slate-200 bg-white transition-all duration-300 relative z-10",
            leftPanelCollapsed ? "w-14" : "w-[300px]"
          )}
        >
          <div className="flex-none border-b border-slate-100 p-3 h-14 flex items-center justify-between">
            {!leftPanelCollapsed && (
              <div className="flex-1 flex items-center gap-2 rounded-lg border border-slate-100 bg-slate-50/50 px-2.5 py-1.5 focus-within:border-indigo-300 transition-all">
                <Search size={12} className="text-slate-400 shrink-0" />
                <input
                  value={search}
                  onChange={(e) => setSearch(e.target.value)}
                  placeholder="Filter jobs..."
                  className="flex-1 bg-transparent text-[11px] text-slate-700 outline-none placeholder-slate-400 font-medium"
                />
              </div>
            )}
            <button 
              onClick={() => setLeftPanelCollapsed(!leftPanelCollapsed)}
              className={cn(
                "flex h-8 w-8 items-center justify-center rounded-lg text-slate-400 hover:bg-slate-50 hover:text-slate-600 transition-all",
                leftPanelCollapsed ? "w-full" : "ml-2"
              )}
            >
              {leftPanelCollapsed ? <PanelLeftOpen size={16} /> : <PanelLeftClose size={16} />}
            </button>
          </div>

          {!leftPanelCollapsed && activeSurface === 'jobs' && (
            <div className="p-2 border-b border-slate-50 flex gap-1 overflow-x-auto no-scrollbar bg-slate-50/20">
              {JOB_STATUS_TABS.map(tab => (
                <button
                  key={tab.value}
                  onClick={() => setActiveStatusFilter(tab.value)}
                  className={cn(
                    "px-3 py-1 rounded-lg text-[8px] font-black uppercase tracking-widest whitespace-nowrap transition-all border",
                    activeStatusFilter === tab.value 
                      ? "bg-slate-900 border-slate-900 text-white shadow-soft-sm" 
                      : "bg-white border-slate-100 text-slate-400 hover:border-slate-200"
                  )}
                >
                  {tab.label}
                </button>
              ))}
            </div>
          )}

          <div className="flex-1 overflow-y-auto custom-scrollbar p-2 space-y-1 bg-[#F8FAFC]/50">
            {isLoading && requisitions.length === 0 ? (
              <div className="py-12 flex justify-center"><Spin size="small" /></div>
            ) : requisitions.length === 0 ? (
              !leftPanelCollapsed && <Empty className="mt-12" image={Empty.PRESENTED_IMAGE_SIMPLE} description={<span className="text-[10px] font-bold text-slate-400 uppercase">Empty</span>} />
            ) : (
              requisitions.map((job) => (
                <JobOperationalCard
                  key={job.id}
                  job={job}
                  selected={selectedJobId === job.id}
                  onSelect={() => handleSelectJob(job.id)}
                  users={users}
                  collapsed={leftPanelCollapsed}
                />
              ))
            )}
          </div>
        </div>

        {/* COLUMN 2: Workspace (Center) */}
        <div className="flex-1 flex flex-col overflow-hidden bg-white">
          {activeSurface === 'jobs' ? (
            selectedJob ? (
              <JobCommandCenter
                job={selectedJob}
                activeTab={activeJobTab}
                setActiveTab={setActiveJobTab}
                onEdit={() => {
                  setEditingJob(selectedJob)
                  setCreateDrawerOpen(true)
                }}
                onRefresh={refetch}
                rightPanelCollapsed={rightPanelCollapsed}
                toggleRightPanel={() => setRightPanelCollapsed(!rightPanelCollapsed)}
              />
            ) : (
              <div className="flex h-full flex-col items-center justify-center gap-3 p-8 text-center bg-[#f8fafc]">
                <div className="h-16 w-16 rounded-[28px] bg-indigo-50 flex items-center justify-center text-indigo-200 mb-4 transform -rotate-6">
                   <Target size={32} />
                </div>
                <Text className="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400">Select a requisition to manage</Text>
              </div>
            )
          ) : (
            <div className="h-full">
              <PipelineBoard jobId={selectedJobId || undefined} />
            </div>
          )}
        </div>

        {/* COLUMN 3: Action Panel (Right) - Jobs Tab only */}
        {activeSurface === 'jobs' && selectedJob && !rightPanelCollapsed && (
          <div className="flex w-[300px] flex-none flex-col overflow-hidden border-l border-slate-200 bg-white transition-all duration-300">
            <JobIntelligencePanel job={selectedJob} onClose={() => setRightPanelCollapsed(true)} />
          </div>
        )}
      </div>

      {/* Global Modals */}
      <Modal
        open={createDrawerOpen}
        onCancel={() => {
          setCreateDrawerOpen(false)
          setEditingJob(null)
        }}
        width={720}
        title={<span className="text-xl font-black tracking-tight text-slate-900 uppercase tracking-widest">{editingJob ? 'Edit Requisition' : 'Create New Requisition'}</span>}
        footer={null}
        destroyOnClose
        className="rounded-3xl overflow-hidden"
      >
        <div className="pt-4">
          <JobCreateForm 
            onSuccess={() => {
              setCreateDrawerOpen(false)
              setEditingJob(null)
              refetch()
            }} 
            initialValues={editingJob} 
          />
        </div>
      </Modal>
    </div>
  )
}

// ─── Sub-components for JobsWorkbench ───────────────────────────────────────

function JobOperationalCard({ job, selected, onSelect, users, collapsed }: any) {
  const statusStyle = getStatusStyle(job.status, 'job')
  const priority = PRIORITY_STYLE[job.priority || 'medium']
  const metadata = (job.metadata || {}) as Record<string, any>
  const owner = users?.find((u: any) => u.id === job.created_by)
  const ownerName = owner ? `${owner.first_name} ${owner.last_name}` : 'Unknown'

  if (collapsed) {
    return (
      <Tooltip title={job.title} placement="right">
        <button
          onClick={onSelect}
          className={cn(
            "w-full aspect-square rounded-xl flex flex-col items-center justify-center transition-all relative group mb-1 border",
            selected
              ? "border-indigo-400 bg-white shadow-sm ring-2 ring-indigo-50"
              : "border-transparent hover:bg-white hover:border-slate-200"
          )}
        >
          <Avatar size={24} style={{ backgroundColor: avatarColor(ownerName), fontSize: '10px' }} className="font-black">
            {ownerName.charAt(0)}
          </Avatar>
          <div className={cn("mt-1.5 h-1.5 w-1.5 rounded-full", statusStyle.dotClass)} />
          {selected && <div className="absolute left-0 top-2 bottom-2 w-1 bg-indigo-600 rounded-r-full" />}
        </button>
      </Tooltip>
    )
  }

  return (
    <button
      onClick={onSelect}
      className={cn(
        "w-full rounded-2xl border p-4 text-left transition-all relative overflow-hidden group mb-1",
        selected
          ? "border-indigo-400 bg-white shadow-soft-xl ring-2 ring-indigo-50"
          : "border-slate-100 bg-white hover:border-slate-200 hover:shadow-soft-md"
      )}
    >
      {selected && <div className="absolute left-0 top-0 bottom-0 w-1 bg-indigo-600 rounded-r-full" />}
      
      <div className="flex items-start justify-between gap-3 mb-3">
        <div className="min-w-0 flex-1">
          <div className={cn(
            "truncate text-xs font-black tracking-tight leading-tight uppercase transition-colors",
            selected ? "text-slate-900" : "text-slate-800"
          )}>
            {job.title || 'Untitled Role'}
          </div>
          <div className="flex items-center gap-1.5 text-[9px] text-slate-400 font-bold uppercase tracking-wider mt-1">
            <span>{job.job_ref_id || 'NO-REF'}</span>
            <span>•</span>
            <span className="truncate">{job.work_mode?.replace('_', ' ')}</span>
          </div>
        </div>
        <div className={cn("h-2 w-2 rounded-full shrink-0 mt-1 shadow-inner", statusStyle.dotClass)} />
      </div>

      <div className="flex items-center justify-between gap-2 pt-3 border-t border-slate-50">
        <div className="flex items-center gap-1.5">
          <Text className="text-[10px] font-black text-slate-700">{metadata.applications_count || 0}</Text>
          <Text className="text-[9px] font-bold text-slate-400 uppercase tracking-tighter">Candidates</Text>
        </div>
        
        <div className="flex items-center gap-2">
          <Avatar size={16} style={{ backgroundColor: avatarColor(ownerName), fontSize: '8px' }} className="font-black border border-white shadow-soft-sm">
            {ownerName.charAt(0)}
          </Avatar>
          <span 
            className="px-1.5 py-0.5 rounded-md text-[7px] font-black uppercase tracking-[0.1em] border shadow-soft-sm"
            style={{ backgroundColor: priority.bg, color: priority.color, borderColor: priority.color + '20' }}
          >
            {priority.label}
          </span>
        </div>
      </div>
    </button>
  )
}

function JobCommandCenter({ job, activeTab, setActiveTab, onEdit, onRefresh, rightPanelCollapsed, toggleRightPanel }: any) {
  const statusStyle = getStatusStyle(job.status, 'job')
  const queryClient = useQueryClient()

  const submitMutation = useMutation({
    mutationFn: () => requisitionsApi.submitForApproval(job.id),
    onSuccess: () => {
      message.success('Submitted for approval')
      queryClient.invalidateQueries({ queryKey: ['jobs'] })
      onRefresh()
    }
  })

  return (
    <div className="flex h-full flex-col overflow-hidden">
      {/* ══ Job Detail Header ═══════════════════════════════════════════════ */}
      <div className="border-b border-slate-100 bg-white px-8 py-6 shrink-0">
        <div className="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-6">
          <div className="flex items-start gap-5">
            <div className="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-slate-900 text-white shadow-soft-xl transform -rotate-3 group-hover:rotate-0 transition-transform">
              <Briefcase size={24} />
            </div>
            <div>
              <div className="flex items-center gap-2 mb-1.5 flex-wrap">
                <span className={cn("inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-[9px] font-black uppercase tracking-[0.1em] border shadow-soft-sm", statusStyle.softClass)}>
                  {formatStatusLabel(job.status)}
                </span>
                <span className={cn(
                  "px-2.5 py-0.5 rounded-full text-[9px] font-black uppercase tracking-[0.1em] border shadow-soft-sm",
                  job.priority === 'urgent' ? "bg-rose-50 text-rose-600 border-rose-100" : "bg-slate-50 text-slate-500 border-slate-100"
                )}>
                  {job.priority} Priority
                </span>
              </div>
              <h1 className="text-xl font-black text-slate-900 tracking-tight leading-none uppercase">{job.title}</h1>
              <div className="flex items-center gap-3 text-[10px] font-bold text-slate-400 uppercase tracking-widest mt-2">
                 <span className="flex items-center gap-1.5"><MapPin size={12} className="text-slate-300"/> {job.location_id || 'Remote'}</span>
                 <span>•</span>
                 <span className="flex items-center gap-1.5"><Building2 size={12} className="text-slate-300"/> {job.department_id || 'Core Team'}</span>
              </div>
            </div>
          </div>
          
          <div className="flex items-center gap-2 self-end lg:self-start">
            <button onClick={onEdit} className="flex h-9 items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 text-[10px] font-black uppercase tracking-widest text-slate-600 hover:bg-slate-50 transition-all shadow-soft-sm active:scale-95">
              <Edit size={14} /> Edit Role
            </button>
            {job.status === 'draft' && (
              <Button type="primary" onClick={() => submitMutation.mutate()} loading={submitMutation.isPending} className="!h-9 !text-[10px] font-black uppercase tracking-widest bg-blue-600 border-none shadow-soft-xl active:scale-95">
                Submit Req
              </Button>
            )}
            <button onClick={toggleRightPanel} className={cn("flex h-9 w-9 items-center justify-center rounded-xl border border-slate-200 transition-all shadow-soft-sm active:scale-95", rightPanelCollapsed ? "bg-white text-slate-400" : "bg-indigo-50 text-indigo-600 border-indigo-100 shadow-inner")}>
              <Info size={18} />
            </button>
          </div>
        </div>
      </div>

      {/* ══ Tabs ═══════════════════════════════════════════════════════════ */}
      <div className="flex h-11 flex-none items-center border-b border-slate-100 bg-white px-8">
        <div className="flex items-center gap-1 h-full">
          {[
            { key: 'overview', label: 'Overview', icon: <Target size={12}/> },
            { key: 'interviews', label: 'Evaluation', icon: <Calendar size={12}/> },
            { key: 'candidates', label: 'Sourcing', icon: <Zap size={12}/> },
            { key: 'activity', label: 'Activity Feed', icon: <Activity size={12}/> },
          ].map(tab => (
            <button
              key={tab.key}
              onClick={() => setActiveTab(tab.key)}
              className={cn(
                "px-5 py-1 text-[10px] font-black uppercase tracking-widest transition h-full relative flex items-center gap-2",
                activeTab === tab.key ? "text-indigo-600" : "text-slate-400 hover:text-slate-600"
              )}
            >
              {tab.icon}{tab.label}
              {activeTab === tab.key && <div className="absolute bottom-0 left-0 h-0.5 w-full bg-indigo-600 rounded-full" />}
            </button>
          ))}
        </div>
      </div>

      <div className="flex-1 overflow-hidden relative bg-[#F8FAFC]/30">
        <div className="absolute inset-0 overflow-y-auto custom-scrollbar p-8">
          {activeTab === 'overview' && <OverviewTabContent job={job} />}
          {activeTab === 'candidates' && <JobMatchSuggestions jobId={job.id} onMatched={() => onRefresh()} />}
          {activeTab === 'activity' && <div className="py-20 text-center"><History size={48} className="mx-auto text-slate-200 mb-4 stroke-[1px]"/><Text className="text-slate-400 font-black uppercase text-[11px] tracking-[0.2em]">Operational History Log</Text></div>}
        </div>
      </div>
    </div>
  )
}

function OverviewTabContent({ job }: any) {
  return (
    <div className="space-y-8 max-w-6xl animate-in fade-in slide-in-from-bottom-2 duration-300 pb-20">
      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          { label: 'Total Tracked', val: job.metadata?.applications_count || 0, color: 'indigo', icon: Users },
          { label: 'In Interview', val: job.metadata?.interview || 0, color: 'orange', icon: Calendar },
          { label: 'Market velocity', val: 'Fast', color: 'emerald', icon: Zap },
          { label: 'Avg Match', val: '8.4', color: 'blue', icon: Sparkles },
        ].map(s => (
          <Card key={s.label} className="rounded-[24px] border-slate-100 shadow-soft-sm overflow-hidden bg-white hover:shadow-soft-md transition-shadow">
             <div className="flex items-center gap-3 mb-2">
                <div className={cn("p-1.5 rounded-lg", `bg-${s.color}-50 text-${s.color}-600`)}><s.icon size={14}/></div>
                <p className="text-[9px] font-black text-slate-400 uppercase tracking-widest m-0">{s.label}</p>
             </div>
             <p className={cn("text-3xl font-black m-0 leading-none", `text-${s.color}-600`)}>{s.val}</p>
          </Card>
        ))}
      </div>

