export default function PipelineBoard({ jobId: externalJobId }: { jobId?: string }) {
  const { t } = useTranslation(['pipeline', 'common'])
  const [selectedJobId, setSelectedJobId] = useState<string>(externalJobId || '')
  
  // Layout States (Managed by parent JobsWorkbench, but kept here for fallback)
  const [rightPanelVisible, setRightPanelVisible] = useState(() => localStorage.getItem('pipeline_right_panel_visible') === 'true')

  const [selectedAppId, setSelectedAppId] = useState<string | null>(null)
  const [viewDensity, setViewDensity] = useState<'comfortable' | 'compact'>('compact')
  const [candidateSearch, setCandidateSearch] = useState('')

  const [boardStageModalOpen, setBoardStageModalOpen] = useState(false)
  const [boardStageNote, setBoardStageNote] = useState('')
  const [boardStageSubmitting, setBoardStageSubmitting] = useState(false)
  const [pendingBoardMove, setPendingBoardMove] = useState<{
    applicationId: string
    targetStageId: string
    targetStageLabel: string
  } | null>(null)

  const user = useAuthStore((s) => s.user)
  const queryClient = useQueryClient()

  useEffect(() => {
    if (externalJobId) setSelectedJobId(externalJobId)
  }, [externalJobId])

  // Persistence
  useEffect(() => localStorage.setItem('pipeline_right_panel_visible', String(rightPanelVisible)), [rightPanelVisible])

  // Fetch specific requisition
  const { data: requisitionData } = useApiQuery(
    ['requisition', 'minimal', selectedJobId],
    () => requisitionsApi.get(selectedJobId),
    { enabled: !!selectedJobId }
  )
  const requisition = (requisitionData as any)?.requisition as JobRequisition
  const isOwner = isJobOwner(user, requisition)

  // Fetch pipeline data
  const { data: pipelineData, isLoading: pipelineLoading, refetch } = useApiQuery(
    ['pipeline', selectedJobId],
    () => pipelineApi.getPipeline(selectedJobId),
    { enabled: !!selectedJobId }
  )

  const { data: candidatesData } = useApiQuery(['candidates', 'all'], () => candidatesApi.list())
  const candidateMap = new Map<string, Candidate>(
    ((candidatesData as { candidates: Candidate[] } | undefined)?.candidates ?? []).map((c) => [c.id, c])
  )

  const orderedStages = useMemo(() => {
    const board = (pipelineData as any)?.pipeline || {}
    const rawStages = Object.values(board).sort((a: any, b: any) => a.stage.stage_order - b.stage.stage_order)
    
    return rawStages.map((s: any) => {
      let apps = s.applications || []
      if (candidateSearch) {
        apps = apps.filter((app: any) => {
          const cand = candidateMap.get(app.candidate_id)
          return cand?.full_name?.toLowerCase().includes(candidateSearch.toLowerCase()) || 
                 cand?.current_title?.toLowerCase().includes(candidateSearch.toLowerCase())
        })
      }
      return { ...s, applications: apps }
    })
  }, [pipelineData, candidateSearch, candidateMap])

  const handleDragEnd = async (result: DropResult) => {
    if (!isOwner) {
      message.warning(t('pipeline:ownership.owner_only'))
      return
    }
    const { source, destination, draggableId } = result
    if (!destination || source.droppableId === destination.droppableId) return

    const stage = orderedStages.find((s: any) => s.stage.id === destination.droppableId)
    setPendingBoardMove({
      applicationId: draggableId,
      targetStageId: destination.droppableId,
      targetStageLabel: stage?.stage?.name || 'Target Stage',
    })
    setBoardStageNote('')
    setBoardStageModalOpen(true)
  }

  const confirmBoardMove = async () => {
    if (!pendingBoardMove || !boardStageNote.trim()) return
    setBoardStageSubmitting(true)
    try {
      await pipelineApi.moveStage(pendingBoardMove.applicationId, pendingBoardMove.targetStageId, boardStageNote.trim())
      message.success(t('pipeline:messages.application_moved', 'Application moved'))
      setBoardStageModalOpen(false)
      setPendingBoardMove(null)
      setBoardStageNote('')
      refetch()
    } catch (err: any) {
      message.error(err?.response?.data?.message || t('pipeline:messages.application_move_failed', 'Failed to move application'))
    } finally {
      setBoardStageSubmitting(false)
    }
  }

  if (!selectedJobId) {
    return (
      <div className="flex flex-1 flex-col items-center justify-center p-20 text-center bg-white/50">
        <div className="h-20 w-20 rounded-[32px] bg-slate-50 flex items-center justify-center text-slate-300 mb-6">
           <Layers size={40} strokeWidth={1.5} />
        </div>
        <Title level={3} className="!m-0 text-slate-400 !font-black uppercase tracking-tight">Pipeline Ready</Title>
        <p className="text-slate-400 mt-2 font-medium text-base">Select a role from the rail on the left to start processing candidates.</p>
      </div>
    )
  }

  return (
    <div className="flex flex-1 overflow-hidden h-full bg-white relative">
      
      {/* ── Center: Workspace ── */}
      <div className="flex-1 flex flex-col overflow-hidden min-w-0">
        
        {/* Command Bar */}
        <div className="px-6 py-2.5 border-b border-slate-100 flex items-center justify-between shrink-0 bg-white/80 backdrop-blur-md z-10">
          <div className="flex items-center gap-3 flex-1">
            <AntInput 
              prefix={<Search size={14} className="text-slate-400" />}
              placeholder="Search in pipeline..."
              className="max-w-xs rounded-xl border-slate-200 h-8 font-medium text-xs bg-slate-50/50"
              value={candidateSearch}
              onChange={e => setCandidateSearch(e.target.value)}
              allowClear
            />
            <Divider type="vertical" className="h-6 mx-2" />
            <Radio.Group value={viewDensity} onChange={e => setViewDensity(e.target.value)} size="small" className="density-toggle">
              <Radio.Button value="comfortable"><Maximize2 size={12} /></Radio.Button>
              <Radio.Button value="compact"><Minimize2 size={12} /></Radio.Button>
            </Radio.Group>
            <Button type="primary" ghost className="rounded-xl h-8 font-black uppercase text-[9px] tracking-widest flex items-center gap-2 border-blue-200 ml-2">
              <Zap size={14} /> Bulk
            </Button>
          </div>
          <div className="flex items-center gap-2 ml-4">
            <button
              onClick={() => setRightPanelVisible(!rightPanelVisible)}
              className={cn(
                "flex h-8 w-8 items-center justify-center rounded-xl border border-slate-200 transition-all",
                rightPanelVisible ? "bg-blue-50 text-blue-600 border-blue-100" : "bg-white text-slate-400"
              )}
            >
              <Info size={16} />
            </button>
          </div>
        </div>

        {/* Kanban Board */}
        <div className="flex-1 overflow-hidden relative bg-[#F8FAFC]/50">
          {pipelineLoading ? (
            <div className="h-full flex items-center justify-center"><Spin size="large" /></div>
          ) : (
            <div className="h-full overflow-x-auto p-4 scrollbar-thin">
              <DragDropContext onDragEnd={handleDragEnd}>
                <div className="flex gap-4 h-full items-start min-w-max pb-4">
                  {orderedStages.map((stageData: any) => (
                    <div key={stageData.stage.id} className="flex flex-col w-[280px] shrink-0 h-full max-h-full bg-slate-100/40 rounded-3xl border border-slate-200/50 overflow-hidden shadow-none hover:border-slate-300/50 transition-colors">
                      <div className="px-4 py-3 bg-white border-b border-slate-200/60 shrink-0">
                        <div className="flex items-center justify-between">
                          <div className="flex items-center gap-2">
                            <div className="h-2 w-2 rounded-full bg-blue-600 shadow-[0_0_8px_rgba(37,99,235,0.4)]" />
                            <Text className="font-black text-slate-900 text-[10px] uppercase tracking-widest">{stageData.stage.name}</Text>
                          </div>
                          <Badge count={stageData.applications?.length || 0} showZero size="small" style={{ backgroundColor: '#f1f5f9', color: '#1e293b', boxShadow: 'none', fontWeight: 'black', fontSize: '9px' }} />
                        </div>
                      </div>

                      <Droppable droppableId={stageData.stage.id}>
                        {(provided, snapshot) => (
                          <div
                            ref={provided.innerRef}
                            {...provided.droppableProps}
                            className={cn("flex-1 overflow-y-auto p-2.5 space-y-2.5 transition-colors", snapshot.isDraggingOver ? "bg-blue-50/30" : "")}
                          >
                            {stageData.applications.map((app: any, i: number) => (
                              <Draggable key={app.id} draggableId={app.id} index={i} isDragDisabled={!isOwner}>
                                {(p, s) => (
                                  <CandidateCard p={p} s={s} app={app} candidateMap={candidateMap} viewDensity={viewDensity} onSelect={() => setSelectedAppId(app.id)} />
                                )}
                              </Draggable>
                            ))}
                            {provided.placeholder}
                          </div>
                        )}
                      </Droppable>
                    </div>
                  ))}
                </div>
              </DragDropContext>
            </div>
          )}
        </div>
      </div>

      {/* ── Right: Intelligence ── */}
      {rightPanelVisible && (
        <div className="flex w-[280px] flex-none flex-col overflow-hidden border-l border-slate-100 bg-white z-20 shadow-sm animate-in slide-in-from-right duration-300">
          <div className="p-4 border-b border-slate-100 flex items-center justify-between h-14 bg-slate-50/50">
            <div className="flex items-center gap-2">
              <Sparkles size={16} className="text-blue-600" />
              <span className="text-[10px] font-black text-slate-900 uppercase tracking-widest">Intelligence</span>
            </div>
            <button onClick={() => setRightPanelVisible(false)} className="text-slate-400 hover:text-slate-600"><X size={16}/></button>
          </div>
          <div className="flex-1 overflow-y-auto p-4 space-y-6">
             <Card bordered={false} className="bg-[#F8FAFC] rounded-2xl">
                <Text className="text-[9px] font-black uppercase text-slate-400 tracking-[0.2em] block mb-3">Market Position</Text>
                <div className="p-3 bg-white rounded-xl border border-slate-100 shadow-soft-sm">
                   <Title level={5} className="!m-0 !text-xs !font-black uppercase tracking-tight text-emerald-600">High Traction</Title>
                   <Text className="text-[11px] text-slate-500 mt-1 block leading-relaxed font-medium">This role is currently performing 18% better than benchmarks.</Text>
                </div>
             </Card>
          </div>
        </div>
      )}

      {/* Candidate Intel Drawer */}
      <Drawer
        open={!!selectedAppId}
        onClose={() => setSelectedAppId(null)}
        width={840}
        styles={{ body: { padding: 0 } }}
        closable={false}
        className="pipeline-detail-drawer"
      >
        {selectedAppId && (
          <ApplicationDetailPanel
            applicationId={selectedAppId}
            onClose={() => setSelectedAppId(null)}
            onRefresh={() => {
              refetch()
              setSelectedAppId(selectedAppId)
            }}
            requisitionStages={orderedStages}
            isOwner={isOwner}
          />
        )}
      </Drawer>

      <Modal
        title={t('pipeline:actions.confirm_stage_change', 'Confirm Stage Change')}
        open={boardStageModalOpen}
        onCancel={() => {
          setBoardStageModalOpen(false)
          setPendingBoardMove(null)
          setBoardStageNote('')
        }}
        onOk={confirmBoardMove}
        okText={t('common:actions.confirm', 'Confirm')}
        confirmLoading={boardStageSubmitting}
        className="rounded-3xl overflow-hidden"
      >
        <div className="space-y-4 pt-4">
          <div className="p-4 bg-slate-50 rounded-2xl border border-slate-100">
            <p className="text-[10px] font-black uppercase tracking-widest text-slate-400 mb-1">Target Stage</p>
            <p className="text-sm font-bold text-blue-600">{pendingBoardMove?.targetStageLabel || '—'}</p>
          </div>
          <div>
            <p className="text-[10px] font-black uppercase tracking-widest text-slate-400 mb-2">Mandatory Context Note</p>
            <TextArea
              rows={4}
              value={boardStageNote}
              onChange={(e) => setBoardStageNote(e.target.value)}
              placeholder="Why is this candidate moving?"
              className="rounded-2xl"
            />
          </div>
        </div>
      </Modal>
    </div>
  )
}

function CandidateCard({ p, s, app, candidateMap, viewDensity, onSelect }: any) {
  const candidate = candidateMap.get(app.candidate_id)
  const isOverdue = dayjs().diff(dayjs(app.updated_at), 'hour') > 48
  
  return (
    <div
      ref={p?.innerRef}
      {...p?.draggableProps}
      {...p?.dragHandleProps}
      onClick={onSelect}
      className={cn(
        "bg-white rounded-2xl border transition-all cursor-pointer relative",
        viewDensity === 'comfortable' ? "p-4" : "p-2.5",
        s?.isDragging ? "rotate-2 scale-105 shadow-xl z-50 ring-2 ring-blue-500/30" : "border-slate-200/60 hover:border-blue-300 hover:shadow-md",
        isOverdue && "border-l-4 border-l-rose-400"
      )}
    >
      <div className="flex items-start gap-2.5">
        <Avatar 
          size={viewDensity === 'comfortable' ? 32 : 28} 
          className="bg-slate-50 text-blue-600 font-black border-none shrink-0 text-[10px]"
        >
          {candidate?.first_name?.charAt(0)}{candidate?.last_name?.charAt(0)}
        </Avatar>
        <div className="min-w-0 flex-1">
          <Text className="block font-black text-slate-900 text-[11px] leading-tight truncate uppercase tracking-tight">
            {candidate?.first_name} {candidate?.last_name}
          </Text>
          <Text className="text-[10px] text-slate-400 font-bold truncate block leading-tight mt-0.5">
            {candidate?.current_title || 'No Title'}
          </Text>
        </div>
      </div>

      <div className={cn("flex items-center justify-between border-t border-slate-50 pt-2", viewDensity === 'comfortable' ? "mt-3" : "mt-2")}>
        <div className="flex items-center gap-1.5">
          <Tag className="m-0 border-none bg-blue-50 text-blue-600 font-black text-[8px] uppercase px-1.5 rounded">
            {app.match_score || 0}%
          </Tag>
        </div>
        <div className="flex items-center gap-1">
          <Clock className={cn("h-2.5 w-2.5", isOverdue ? "text-rose-400" : "text-slate-300")} />
          <span className={cn("text-[9px] font-black uppercase", isOverdue ? "text-rose-500" : "text-slate-400")}>
            {dayjs(app.updated_at).fromNow(true)}
          </span>
        </div>
      </div>
    </div>
  )
}
