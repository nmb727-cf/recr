        </Form.Item>
        <Form.Item name="preferred_industries" label="Preferred Industries" className="col-span-2">
          <Select mode="tags" placeholder="e.g. Fintech, SaaS, Healthcare" tokenSeparators={[',']}
            className="[&_.ant-select-selector]:rounded-lg" />
