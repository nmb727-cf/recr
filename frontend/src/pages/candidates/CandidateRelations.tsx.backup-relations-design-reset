// ── Main Component ────────────────────────────────────────────────────────────

export default function CandidateRelations() {
  const [viewMode, setViewMode] = useState<'board' | 'list'>('board')
  const [search, setSearch] = useState('')
  const [ownerFilter, setOwnerFilter] = useState<string | null>(null)
  const [isQuickAddOpen, setIsQuickAddOpen] = useState(false)
  const [selectedCandidate, setSelectedCandidate] = useState<RelationCandidate | null>(null)
  const [isDetailModalOpen, setIsDetailModalOpen] = useState(false)
  const [isSubmitModalOpen, setIsSubmitModalOpen] = useState(false)
  const queryClient = useQueryClient()

  // ── Queries ──────────────────────────────────────────────────────────────
  const { data: pipelineData, isLoading, isError } = useApiQuery(
    ['candidates-crm-pipeline'],
    candidatesApi.crmPipeline
  )

  const { data: remindersData } = useApiQuery(
    ['candidates-crm-reminders'],
    candidatesApi.crmReminders
  )

  // ── Mutations ─────────────────────────────────────────────────────────────
  const moveMutation = useMutation({
    mutationFn: ({ id, status, note }: { id: string; status: string; note: string }) =>
      candidatesApi.moveCRMPipeline(id, { status, note }),
    onSuccess: () => {
      message.success('Stage updated')
      queryClient.invalidateQueries({ queryKey: ['candidates-crm-pipeline'] })
    },
    onError: (err: any) => message.error(err?.response?.data?.message || 'Failed to move candidate')
  })

  const pipeline = (pipelineData as any)?.pipeline || {}
  const reminders = (remindersData as any)?.reminders || []

  // ── Render Helpers ────────────────────────────────────────────────────────

  if (isLoading) return <div className="flex h-96 items-center justify-center"><Spin size="large" /></div>

  return (
    <div className="flex flex-1 flex-col bg-[#F8FAFC] overflow-hidden p-6 gap-6">
      
      {/* ══ Top Bar ══════════════════════════════════════════════════════════ */}
      <div className="flex flex-none items-center justify-between">
        <div className="flex flex-col gap-1">
          <Title level={3} className="!m-0 tracking-tight font-black uppercase">Candidate Relations</Title>
          <Text className="text-xs text-slate-400 font-bold uppercase tracking-widest flex items-center gap-2">
            <Target size={12} className="text-indigo-500" /> Pre-ATS Lead Nurturing Terminal
          </Text>
        </div>

        <div className="flex items-center gap-3">
          <div className="flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-1.5 focus-within:border-indigo-300 focus-within:ring-2 focus-within:ring-indigo-100 transition-all shadow-soft-sm">
            <Search size={14} className="text-slate-400" />
            <input 
              value={search}
              onChange={e => setSearch(e.target.value)}
              placeholder="Search leads..." 
              className="bg-transparent text-xs font-medium outline-none w-48" 
            />
          </div>

          <Space className="bg-white p-1 rounded-xl border border-slate-200 shadow-soft-sm">
            <Button 
              type={viewMode === 'board' ? 'primary' : 'text'} 
              size="small" 
              icon={<Layout size={14} />} 
              onClick={() => setViewMode('board')}
              className={cn("rounded-lg h-8 px-3 font-black uppercase text-[10px]", viewMode === 'board' && "bg-slate-900 border-none")}
            >Board</Button>
            <Button 
              type={viewMode === 'list' ? 'primary' : 'text'} 
              size="small" 
              icon={<List size={14} />} 
              onClick={() => setViewMode('list')}
              className={cn("rounded-lg h-8 px-3 font-black uppercase text-[10px]", viewMode === 'list' && "bg-slate-900 border-none")}
            >List</Button>
          </Space>

          <Badge count={reminders.length} offset={[-2, 2]}>
            <Button icon={<Clock size={16} />} className="rounded-xl h-10 border-slate-200 shadow-soft-sm" />
          </Badge>

          <Button 
            type="primary" 
            icon={<Plus size={16} />} 
            onClick={() => setIsQuickAddOpen(true)}
            className="rounded-xl h-10 bg-indigo-600 font-black uppercase text-[10px] tracking-widest border-none shadow-indigo-100 shadow-lg"
          >Add Candidate</Button>
        </div>
      </div>

      {/* ══ Main View ════════════════════════════════════════════════════════ */}
      <div className="flex-1 overflow-hidden">
        {viewMode === 'board' ? (
          <BoardView 
            pipeline={pipeline} 
            onSelect={(c) => { setSelectedCandidate(c); setIsDetailModalOpen(true) }}
            onSubmit={(c) => { setSelectedCandidate(c); setIsSubmitModalOpen(true) }}
            onMove={(id, status) => {
              Modal.confirm({
                title: 'Confirm Stage Transition',
                content: (
                  <div className="pt-4 space-y-4">
                    <p className="text-xs text-slate-500 font-medium">Please provide a rationale for moving this candidate to <Tag color="blue">{status.replace('_',' ')}</Tag></p>
                    <Input.TextArea id="move-note" placeholder="Mandatory rationale..." rows={4} className="rounded-xl" />
                  </div>
                ),
                onOk: () => {
                  const note = (document.getElementById('move-note') as HTMLTextAreaElement)?.value
                  if (!note) { message.error('Rationale is required'); return Promise.reject() }
                  moveMutation.mutate({ id, status, note })
                },
                okText: 'Confirm Move',
                okButtonProps: { className: 'bg-indigo-600 rounded-lg font-bold' }
              })
            }}
          />
        ) : (
          <ListView pipeline={pipeline} />
        )}
      </div>

      <QuickAddModal 
        open={isQuickAddOpen} 
        onClose={() => setIsQuickAddOpen(false)} 
        onSuccess={() => queryClient.invalidateQueries({ queryKey: ['candidates-crm-pipeline'] })} 
      />

      <InteractionTrackingModal
        open={isDetailModalOpen}
        candidate={selectedCandidate}
        onClose={() => setIsDetailModalOpen(false)}
      />

      <SubmitToJobModal
        open={isSubmitModalOpen}
        candidate={selectedCandidate}
        onClose={() => setIsSubmitModalOpen(false)}
        onSuccess={() => {
          setIsSubmitModalOpen(false)
          queryClient.invalidateQueries({ queryKey: ['candidates-crm-pipeline'] })
        }}
      />
    </div>
  )
}

