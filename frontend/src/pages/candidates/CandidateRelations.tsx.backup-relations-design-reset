function InteractionTrackingModal({ open, candidate, onClose }: { open: boolean; candidate: RelationCandidate | null; onClose: () => void }) {
  const [form] = Form.useForm()
  const queryClient = useQueryClient()

  const logMutation = useMutation({
    mutationFn: (values: any) => candidatesApi.logCRMInteraction(candidate!.candidate_id, values),
    onSuccess: () => {
      message.success('Interaction logged')
      queryClient.invalidateQueries({ queryKey: ['candidates-crm-interactions', candidate?.candidate_id] })
      form.resetFields()
    }
  })

  const { data: interactionsData } = useApiQuery(
    ['candidates-crm-interactions', candidate?.candidate_id],
    () => candidatesApi.crmInteractions(candidate!.candidate_id),
    { enabled: !!candidate && open }
  )

  const interactions = (interactionsData as any)?.interactions || []

  return (
    <Modal
      title={<div className="flex items-center gap-2"><MessageSquare size={18} className="text-indigo-600" /><span className="font-black uppercase tracking-tight">{candidate?.name} — Interaction Hub</span></div>}
      open={open}
      onCancel={onClose}
      footer={null}
      width={720}
      className="rounded-[2.5rem] overflow-hidden"
    >
      <div className="flex gap-6 py-6 h-[500px]">
        <div className="w-1/2 flex flex-col gap-4 border-r border-slate-100 pr-6">
          <Text className="text-[10px] font-black uppercase text-slate-400 tracking-widest pl-1">Log Activity</Text>
          <Form form={form} layout="vertical" onFinish={(v) => logMutation.mutate(v)}>
            <Form.Item name="interaction_type" label="Channel" initialValue="call">
              <Select options={[
                { value: 'call', label: 'Call' },
                { value: 'email', label: 'Email' },
                { value: 'whatsapp', label: 'WhatsApp' },
                { value: 'note', label: 'Internal Note' },
                { value: 'meeting', label: 'Meeting' },
              ]} className="rounded-xl" />
            </Form.Item>
            <Form.Item name="content" label="Highlights / Outcome" rules={[{ required: true }]}>
              <Input.TextArea placeholder="What was discussed?" rows={4} className="rounded-xl" />
            </Form.Item>
            <div className="flex items-center gap-4">
               <Form.Item name="next_followup_date" label="Next Follow-up" className="flex-1">
                  <DatePicker className="w-full rounded-xl" />
               </Form.Item>
               <Button 
                 type="primary" 
                 htmlType="submit" 
                 loading={logMutation.isPending}
                 className="bg-slate-900 rounded-xl h-10 font-black uppercase text-[10px] px-6 mt-1"
               >Log</Button>
            </div>
          </Form>
        </div>
        <div className="w-1/2 flex flex-col gap-4 overflow-hidden">
          <Text className="text-[10px] font-black uppercase text-slate-400 tracking-widest pl-1">Interaction History</Text>
          <div className="flex-1 overflow-y-auto custom-scrollbar space-y-3">
            {interactions.map((i: any) => (
              <div key={i.id} className="p-4 rounded-2xl bg-slate-50 border border-slate-100">
                <div className="flex items-center justify-between mb-2">
                  <Tag className="rounded-lg text-[8px] font-black uppercase">{i.interaction_type}</Tag>
                  <Text className="text-[9px] font-bold text-slate-400 uppercase">{dayjs(i.created_at).fromNow()}</Text>
                </div>
                <Paragraph className="text-xs m-0 text-slate-600 line-clamp-3 italic">"{i.content}"</Paragraph>
              </div>
            ))}
            {interactions.length === 0 && <Empty description="No history yet" className="mt-12" />}
          </div>
        </div>
      </div>
    </Modal>
  )
}

function SubmitToJobModal({ open, candidate, onClose, onSuccess }: { open: boolean; candidate: RelationCandidate | null; onClose: () => void; onSuccess: () => void }) {
  const [targetJobId, setTargetJobId] = useState<string | null>(null)
  const queryClient = useQueryClient()

  const { data: jobsData } = useApiQuery(['active-jobs-list'], () => http.get('/jobs/requisitions/?status=open'))
  const jobs = (jobsData as any)?.data || []

  const submitMutation = useMutation({
    mutationFn: async () => {
      // 1. Move CRM status to submitted
      await candidatesApi.moveCRMPipeline(candidate!.pipeline_id, { 
        status: 'submitted', 
        note: `Submitted to job: ${targetJobId}` 
      })
      // 2. Create actual application (ATS handoff)
      // Assuming pipelineApi.submitCandidate exists
      await http.post('/pipeline/pipeline/submit/', {
        candidate_id: candidate!.candidate_id,
        requisition_id: targetJobId,
        source: 'relations_nurture'
      })
    },
    onSuccess: () => {
      message.success('Candidate successfully handed off to ATS')
      onSuccess()
    }
  })

  return (
    <Modal
      title={<div className="flex items-center gap-2"><Target size={18} className="text-indigo-600" /><span className="font-black uppercase tracking-tight">ATS Submission Handoff</span></div>}
      open={open}
      onCancel={onClose}
      onOk={() => {
        if (!targetJobId) return message.error('Select target job')
        submitMutation.mutate()
      }}
      okText="Confirm Submission"
      confirmLoading={submitMutation.isPending}
      className="rounded-[2.5rem] overflow-hidden"
      width={480}
      okButtonProps={{ className: 'bg-indigo-600 h-10 px-8 rounded-xl font-black uppercase text-[10px] tracking-widest border-none' }}
    >
      <div className="py-6 space-y-6">
        <div className="p-5 rounded-3xl bg-slate-900 text-white flex items-center gap-4">
           <Avatar size={40} className="bg-indigo-500 font-black">{candidate?.name.charAt(0)}</Avatar>
           <div>
              <Text className="block text-white font-black uppercase tracking-tight leading-none">{candidate?.name}</Text>
              <Text className="text-indigo-300 text-[10px] font-bold uppercase tracking-widest mt-1 block">Ready for Production Pipeline</Text>
           </div>
        </div>

        <div className="space-y-2">
          <Text className="text-[10px] font-black uppercase text-slate-400 tracking-widest pl-1">Target Job Requisition</Text>
          <Select
            className="w-full enterprise-select-lg"
            placeholder="Search active jobs..."
            showSearch
            onChange={setTargetJobId}
            options={jobs.map((j: any) => ({
              value: j.id,
              label: `${j.title} (${j.job_ref_id})`
            }))}
          />
        </div>
        
        <Alert 
          showIcon 
          type="info" 
          message="Handoff Rule" 
          description="Submitting will move this candidate from Relations to the Active ATS pipeline for the selected job. This action is tracked in both modules." 
          className="rounded-2xl"
        />
      </div>
    </Modal>
  )
}

