function ListView({ pipeline }: { pipeline: Record<string, RelationCandidate[]> }) {
  const allCandidates = Object.values(pipeline).flat()
  const columns: ColumnsType<RelationCandidate> = [
    { 
      title: 'Candidate', 
      dataIndex: 'name', 
      render: (text, record) => (
        <Space>
          <Avatar size="small" className="bg-indigo-50 text-indigo-600 font-black text-[10px] uppercase">{text.charAt(0)}</Avatar>
          <div>
            <Text strong className="text-xs uppercase tracking-tight block">{text}</Text>
            <Text className="text-[9px] font-bold text-slate-400 uppercase tracking-widest">{record.current_title}</Text>
          </div>
        </Space>
      )
    },
    { 
      title: 'Stage', 
      dataIndex: 'status', 
      render: (_, record) => {
        const stage = STAGES.find(s => s.key === record.pipeline_id) // Wait, pipeline_id isn't the status key in the raw data... logic error in mock?
        // In real API, the key in the pipeline object is the status.
        return <Tag className="rounded-lg font-black uppercase text-[9px]">{record.pipeline_id?.replace('_',' ')}</Tag>
      } 
    },
    { 
      title: 'Next Action', 
      dataIndex: 'next_action',
      render: (text, record) => (
        <div className="flex flex-col">
          <Text className="text-[10px] font-black uppercase text-indigo-600">{text || '—'}</Text>
          {record.next_action_date && <Text className="text-[9px] text-slate-400">{dayjs(record.next_action_date).format('MMM DD')}</Text>}
        </div>
      )
    },
    { title: 'Days in Stage', dataIndex: 'days_in_stage', align: 'center', render: (v) => <Text className="text-xs font-bold">{v}d</Text> },
    { title: 'Sentiment', dataIndex: 'sentiment', render: (v) => <Tag color={v === 'positive' ? 'green' : v === 'negative' ? 'red' : 'default'} className="rounded-lg text-[9px] font-black">{v?.toUpperCase()}</Tag> },
  ]

  return (
    <Card className="rounded-3xl border-slate-200 shadow-soft-sm overflow-hidden" bodyStyle={{ padding: 0 }}>
      <Table columns={columns} dataSource={allCandidates} rowKey="pipeline_id" pagination={false} />
    </Card>
  )
}

function QuickAddModal({ open, onClose, onSuccess }: { open: boolean; onClose: () => void; onSuccess: () => void }) {
  const [form] = Form.useForm()
  const queryClient = useQueryClient()

  const createMutation = useMutation({
    mutationFn: (values: any) => candidatesApi.create(values),
    onSuccess: async (res) => {
      const candidateId = res.data.candidate.id
      // Now add to CRM
      await candidatesApi.addToCRMPipeline({
        candidate_id: candidateId,
        intent: form.getFieldValue('intent'),
        status: 'new_lead'
      })
      message.success('Candidate added to Relations')
      onSuccess()
      onClose()
      form.resetFields()
    }
  })

  return (
    <Modal
      title={<div className="flex items-center gap-2"><Target size={18} className="text-indigo-600" /><span className="font-black uppercase tracking-tight">Rapid Lead Intake</span></div>}
      open={open}
      onCancel={onClose}
      onOk={() => form.submit()}
      confirmLoading={createMutation.isPending}
      className="rounded-[2.5rem] overflow-hidden"
      width={520}
      okText="Ingest Lead"
      okButtonProps={{ className: 'bg-indigo-600 h-10 px-8 rounded-xl font-black uppercase text-[10px] tracking-widest border-none' }}
      cancelButtonProps={{ className: 'rounded-xl h-10 px-6 font-bold uppercase text-[10px]' }}
    >
      <Form form={form} layout="vertical" className="pt-6" onFinish={(v) => createMutation.mutate(v)}>
        <Row gutter={16}>
          <Col span={12}>
            <Form.Item name="first_name" label="First Name" rules={[{ required: true }]}>
              <Input placeholder="John" className="rounded-xl h-10 font-medium" />
            </Form.Item>
          </Col>
          <Col span={12}>
            <Form.Item name="last_name" label="Last Name" rules={[{ required: true }]}>
              <Input placeholder="Doe" className="rounded-xl h-10 font-medium" />
            </Form.Item>
          </Col>
        </Row>
        <Form.Item name="email" label="Primary Email" rules={[{ required: true, type: 'email' }]}>
          <Input placeholder="candidate@example.com" className="rounded-xl h-10 font-medium" />
        </Form.Item>
        <Form.Item name="current_title" label="Current Role / Designation">
          <Input placeholder="Senior Software Engineer" className="rounded-xl h-10 font-medium" />
        </Form.Item>
        
        <div className="bg-slate-50 p-5 rounded-[2rem] border border-slate-100 mt-2">
          <Form.Item name="intent" label="Entry Intent" initialValue="just_lead" className="mb-0">
            <Select options={INTENT_OPTIONS} className="enterprise-select-lg" />
          </Form.Item>
          <Text className="text-[10px] text-slate-400 font-bold uppercase tracking-tight mt-3 block">Intent guides automatic nurture workflows and priority logic.</Text>
        </div>
      </Form>
    </Modal>
  )
}
