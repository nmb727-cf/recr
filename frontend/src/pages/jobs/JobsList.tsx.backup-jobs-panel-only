                   <p className="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1">Quality Score</p>
                   <p className="text-2xl font-black text-emerald-600">8.4</p>
                </Card>
              </div>

              <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <div className="lg:col-span-2 space-y-6">
                  <Card title={<span className="text-xs font-black uppercase tracking-widest">Description</span>} className="rounded-2xl border-slate-100 shadow-soft-sm overflow-hidden">
                    <Paragraph className="text-slate-600 whitespace-pre-wrap">{job.description || 'No description provided.'}</Paragraph>
                  </Card>
                </div>
                <div className="space-y-6">
                   <Card title={<span className="text-xs font-black uppercase tracking-widest">Requirements</span>} className="rounded-2xl border-slate-100 shadow-soft-sm">
                      <div className="space-y-3">
                         <div className="flex justify-between items-center"><span className="text-[11px] text-slate-500 font-bold uppercase">Exp</span><span className="text-xs font-black text-slate-800">{job.experience_min}-{job.experience_max}y</span></div>
                         <div className="flex justify-between items-center"><span className="text-[11px] text-slate-500 font-bold uppercase">Salary</span><span className="text-xs font-black text-indigo-600">{formatSalary(job.salary_min)} - {formatSalary(job.salary_max)}</span></div>
                      </div>
                   </Card>
                </div>
              </div>
            </div>
          )}

          {activeTab === 'candidates' && (
            <JobMatchSuggestions jobId={job.id} onMatched={() => onRefresh()} />
          )}
        </div>
      </div>
    </div>
  )
}

